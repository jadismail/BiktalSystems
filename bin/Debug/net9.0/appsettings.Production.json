{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=biktal;Username=postgres;Password=postgres"
  },
  "Seed": {
    "AdminEmail": "admin@biktal.local",
    "AdminPassword": "ChangeThisPassword1!",
    "CreateBootstrapAdmin": true,
    "AllowPublicRegistration": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/biktal-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
