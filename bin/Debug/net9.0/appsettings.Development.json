{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=biktal;Username=postgres;Password=postgres"
  },
  "Seed": {
    "AdminEmail": "admin@biktal.com",
    "AdminPassword": "Azaz0909!",
    "CreateBootstrapAdmin": true,
    "ResetBootstrapAdminPassword": true,
    "AllowPublicRegistration": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
