{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=biktal;Username=postgres;Password=postgres"
  },
  "Seed": {
    "AdminEmail": "admin@biktal.local",
    "AdminPassword": "ChangeThisPassword1!",
    "CreateBootstrapAdmin": true,
    "AllowPublicRegistration": false,
    "SeedDemoData": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Backup": {
    "Enabled": true,
    "Directory": "C:\\iShopBackups",
    "IntervalDays": 7,
    "RetentionCount": 8,
    "CheckIntervalHours": 1
  }
}
