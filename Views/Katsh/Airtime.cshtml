@model KatshAirtimePageViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Airtime";
    ViewData["Module"] = "Katsh";
    var isTouch = !string.Equals(Model.SellForm.Provider, "Alfa", StringComparison.OrdinalIgnoreCase);
    var isUsd = !string.Equals(Model.SellForm.Currency, "LBP", StringComparison.OrdinalIgnoreCase);
    var pricePayload = Model.Providers.ToDictionary(
        p => p.Provider,
        p => new
        {
            priceUsd = p.PriceUsd,
            priceLbp = p.PriceLbp,
            costOneUsd = p.CostOneUsd,
            costOneLbp = p.CostOneLbp,
            costTwoUsd = p.CostTwoUsd,
            costTwoLbp = p.CostTwoLbp,
            costThreeUsd = p.CostThreePlusUsd,
            costThreeLbp = p.CostThreePlusLbp
        },
        StringComparer.OrdinalIgnoreCase);
    var priceJson = JsonSerializer.Serialize(pricePayload);
}

<div class="container pb-5 pt-3 bk-katsh">
    @await Component.InvokeAsync("ModuleNav")
    <div class="bk-katsh-top">
        <partial name="_ModuleHeader" />
        <partial name="_KatshBalances" model="(Model.BalanceUsd, Model.BalanceLbp)" />
    </div>

    @if (TempData["KatshMessage"] is string okMsg)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="status">
            <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@okMsg</div>
        </div>
    }
    @if (TempData["KatshError"] is string errMsg)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@errMsg</div>
        </div>
    }

    <partial name="_KatshAccountsGate" model="Model.IsAccountsSessionOpen" />

    @if (Model.CanEditPrices)
    {
        <details class="bk-katsh-price-admin mb-4">
            <summary class="bk-katsh-price-admin-summary">
                <i class="bi bi-sliders" aria-hidden="true"></i>
                <span>Edit price &amp; cost</span>
                <span class="bk-katsh-price-admin-badge">Admin</span>
            </summary>
            <form asp-action="SaveAirtimePrices" method="post" class="bk-katsh-price-admin-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger small fw-semibold mb-3"></div>
                <p class="small text-muted mb-3">
                    Selling <strong>price</strong> is always the same per credit.
                    <strong>Cost</strong> (deducted from Katsh balance) changes by how many credits you sell.
                </p>
                <div class="bk-katsh-price-admin-grid">
                    @for (var i = 0; i < Model.EditForm.Rows.Count; i++)
                    {
                        <div class="bk-katsh-price-admin-row">
                            <input type="hidden" asp-for="EditForm.Rows[i].Provider" />
                            <div class="bk-katsh-price-admin-name">@Model.EditForm.Rows[i].Provider</div>

                            <div class="bk-katsh-airtime-tier mb-2">
                                <div class="bk-katsh-airtime-tier-label">Selling price (always)</div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1" asp-for="EditForm.Rows[i].PriceUsd">Price / credit ($)</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="EditForm.Rows[i].PriceUsd" class="form-control text-end" step="any" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1" asp-for="EditForm.Rows[i].PriceLbp">Price / credit (L.L)</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="EditForm.Rows[i].PriceLbp" class="form-control text-end" step="any" min="0" />
                                            <span class="input-group-text">L.L</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bk-katsh-airtime-tier mb-2">
                                <div class="bk-katsh-airtime-tier-label">Cost when selling 1 credit</div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1" asp-for="EditForm.Rows[i].CostOneUsd">Cost / credit ($)</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="EditForm.Rows[i].CostOneUsd" class="form-control text-end" step="any" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1" asp-for="EditForm.Rows[i].CostOneLbp">Cost / credit (L.L)</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="EditForm.Rows[i].CostOneLbp" class="form-control text-end" step="any" min="0" />
                                            <span class="input-group-text">L.L</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bk-katsh-airtime-tier mb-2">
                                <div class="bk-katsh-airtime-tier-label">Cost when selling 2 credits</div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1" asp-for="EditForm.Rows[i].CostTwoUsd">Cost / credit ($)</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="EditForm.Rows[i].CostTwoUsd" class="form-control text-end" step="any" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1" asp-for="EditForm.Rows[i].CostTwoLbp">Cost / credit (L.L)</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="EditForm.Rows[i].CostTwoLbp" class="form-control text-end" step="any" min="0" />
                                            <span class="input-group-text">L.L</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bk-katsh-airtime-tier">
                                <div class="bk-katsh-airtime-tier-label">Cost when selling 3+ credits</div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1" asp-for="EditForm.Rows[i].CostThreePlusUsd">Cost / credit ($)</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="EditForm.Rows[i].CostThreePlusUsd" class="form-control text-end" step="any" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1" asp-for="EditForm.Rows[i].CostThreePlusLbp">Cost / credit (L.L)</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="EditForm.Rows[i].CostThreePlusLbp" class="form-control text-end" step="any" min="0" />
                                            <span class="input-group-text">L.L</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-primary fw-semibold mt-3">
                    <i class="bi bi-check2 me-1" aria-hidden="true"></i>Save settings
                </button>
            </form>
        </details>
    }

    <section class="bk-katsh-airtime" aria-label="Airtime">
        <div class="bk-katsh-airtime-layout">
            <form asp-action="SellAirtime" method="post" id="bk-katsh-airtime-form" class="bk-katsh-airtime-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>

                <div class="bk-katsh-airtime-field">
                    <span class="bk-katsh-airtime-label">Network</span>
                    <div class="bk-katsh-airtime-pills" role="group" aria-label="Network">
                        <label class="bk-katsh-airtime-pill bk-katsh-airtime-pill--touch">
                            <input type="radio" name="SellForm.Provider" value="Touch" @(isTouch ? "checked" : null) />
                            <span class="bk-katsh-airtime-pill-face">
                                <span class="bk-katsh-airtime-pill-dot" aria-hidden="true"></span>
                                <span>Touch</span>
                            </span>
                        </label>
                        <label class="bk-katsh-airtime-pill bk-katsh-airtime-pill--alfa">
                            <input type="radio" name="SellForm.Provider" value="Alfa" @(!isTouch ? "checked" : null) />
                            <span class="bk-katsh-airtime-pill-face">
                                <span class="bk-katsh-airtime-pill-dot" aria-hidden="true"></span>
                                <span>Alfa</span>
                            </span>
                        </label>
                    </div>
                    <span asp-validation-for="SellForm.Provider" class="text-danger small"></span>
                </div>

                <div class="bk-katsh-airtime-field">
                    <span class="bk-katsh-airtime-label">Currency</span>
                    <div class="bk-katsh-airtime-pills" role="group" aria-label="Currency">
                        <label class="bk-katsh-airtime-pill">
                            <input type="radio" name="SellForm.Currency" value="USD" @(isUsd ? "checked" : null) />
                            <span class="bk-katsh-airtime-pill-face">USD</span>
                        </label>
                        <label class="bk-katsh-airtime-pill">
                            <input type="radio" name="SellForm.Currency" value="LBP" @(!isUsd ? "checked" : null) />
                            <span class="bk-katsh-airtime-pill-face">LBP</span>
                        </label>
                    </div>
                    <span asp-validation-for="SellForm.Currency" class="text-danger small"></span>
                </div>

                <div class="bk-katsh-airtime-field">
                    <label asp-for="SellForm.Credits" class="bk-katsh-airtime-label"></label>
                    <div class="bk-katsh-airtime-credits">
                        <button type="button" class="bk-katsh-airtime-step" id="bk-katsh-airtime-minus" aria-label="Fewer credits">−</button>
                        <input asp-for="SellForm.Credits"
                               class="form-control bk-katsh-airtime-credits-input"
                               inputmode="numeric"
                               min="1"
                               max="999"
                               step="1"
                               id="bk-katsh-airtime-credits"
                               autofocus />
                        <button type="button" class="bk-katsh-airtime-step" id="bk-katsh-airtime-plus" aria-label="More credits">+</button>
                    </div>
                    <span asp-validation-for="SellForm.Credits" class="text-danger small"></span>
                </div>

                <button type="button"
                        class="btn btn-primary fw-semibold bk-katsh-airtime-submit"
                        id="bk-katsh-airtime-review"
                        @(Model.CanSell ? null : "disabled")>
                    <i class="bi bi-cart-check me-1" aria-hidden="true"></i>Review &amp; deduct
                </button>
            </form>

            <aside class="bk-katsh-airtime-quote" aria-live="polite" aria-label="Live quote">
                <div class="bk-katsh-airtime-quote-head">
                    <span class="bk-katsh-airtime-quote-kicker">Live quote</span>
                    <span class="bk-katsh-airtime-quote-badge" id="bk-katsh-airtime-tier">—</span>
                </div>

                <div class="bk-katsh-airtime-quote-total">
                    <span class="bk-katsh-airtime-quote-total-label">Customer pays</span>
                    <strong class="bk-katsh-airtime-quote-total-value" id="bk-katsh-airtime-sale-total">—</strong>
                </div>

                <dl class="bk-katsh-airtime-quote-rows">
                    <div class="bk-katsh-airtime-quote-row">
                        <dt>Sell / credit</dt>
                        <dd id="bk-katsh-airtime-unit-price">—</dd>
                    </div>
                    <div class="bk-katsh-airtime-quote-row">
                        <dt>Cost / credit</dt>
                        <dd id="bk-katsh-airtime-unit-cost">—</dd>
                    </div>
                    <div class="bk-katsh-airtime-quote-row bk-katsh-airtime-quote-row--accent">
                        <dt>Deduct from balance</dt>
                        <dd id="bk-katsh-airtime-cost-total">—</dd>
                    </div>
                </dl>
            </aside>
        </div>
    </section>
</div>

<div class="bk-admin-modal d-none" id="bk-katsh-airtime-modal" role="dialog" aria-modal="true"
     aria-labelledby="bk-katsh-airtime-modal-title">
    <div class="bk-admin-modal-backdrop" data-katsh-airtime-dismiss tabindex="-1" aria-hidden="true"></div>
    <div class="bk-admin-modal-panel" role="document">
        <button type="button" class="bk-admin-modal-close" data-katsh-airtime-dismiss aria-label="Close">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
        <div class="bk-admin-modal-icon" aria-hidden="true">
            <i class="bi bi-wallet2"></i>
        </div>
        <h2 class="bk-admin-modal-title" id="bk-katsh-airtime-modal-title">Cash or Whish?</h2>
        <p class="bk-admin-modal-desc" id="bk-katsh-airtime-modal-desc">
            Choose how the customer is paying for this airtime.
        </p>
        <div class="bk-katsh-sell-summary">
            <div class="bk-katsh-sell-row">
                <span class="bk-katsh-sell-label">Sale</span>
                <span class="bk-katsh-sell-value" id="bk-katsh-airtime-summary-label">—</span>
            </div>
            <div class="bk-katsh-sell-row">
                <span class="bk-katsh-sell-label">Customer pays</span>
                <span class="bk-katsh-sell-value" id="bk-katsh-airtime-summary-sale">—</span>
            </div>
            <div class="bk-katsh-sell-row">
                <span class="bk-katsh-sell-label">Deduct</span>
                <span class="bk-katsh-sell-value bk-katsh-sell-value--strong" id="bk-katsh-airtime-summary-cost">—</span>
            </div>
        </div>
        <div class="bk-katsh-pay-choices" role="group" aria-label="Payment method">
            <button type="submit" form="bk-katsh-airtime-form" name="SellForm.PaymentMethod" value="Cash"
                    class="bk-katsh-pay-choice bk-katsh-pay-choice--cash">
                <i class="bi bi-cash-coin" aria-hidden="true"></i>
                <span>Cash</span>
            </button>
            <button type="submit" form="bk-katsh-airtime-form" name="SellForm.PaymentMethod" value="Whish"
                    class="bk-katsh-pay-choice bk-katsh-pay-choice--whish">
                <i class="bi bi-phone" aria-hidden="true"></i>
                <span>Whish</span>
            </button>
        </div>
        <div class="bk-katsh-pay-cancel">
            <button type="button" class="btn btn-link text-muted fw-semibold text-decoration-none" data-katsh-airtime-dismiss>Cancel</button>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(function () {
    var form = document.getElementById("bk-katsh-airtime-form");
    var modal = document.getElementById("bk-katsh-airtime-modal");
    var reviewBtn = document.getElementById("bk-katsh-airtime-review");
    if (!form || !modal || !reviewBtn) return;

    var prices = @Html.Raw(priceJson);
    var creditsInput = document.getElementById("bk-katsh-airtime-credits");
    var minusBtn = document.getElementById("bk-katsh-airtime-minus");
    var plusBtn = document.getElementById("bk-katsh-airtime-plus");
    var tierEl = document.getElementById("bk-katsh-airtime-tier");
    var unitPriceEl = document.getElementById("bk-katsh-airtime-unit-price");
    var saleTotalEl = document.getElementById("bk-katsh-airtime-sale-total");
    var unitCostEl = document.getElementById("bk-katsh-airtime-unit-cost");
    var costTotalEl = document.getElementById("bk-katsh-airtime-cost-total");
    var summaryLabel = document.getElementById("bk-katsh-airtime-summary-label");
    var summarySale = document.getElementById("bk-katsh-airtime-summary-sale");
    var summaryCost = document.getElementById("bk-katsh-airtime-summary-cost");
    var descEl = document.getElementById("bk-katsh-airtime-modal-desc");

    function selectedValue(name) {
        var checked = form.querySelector('input[name="' + name + '"]:checked');
        return checked ? checked.value : "";
    }

    function formatMoney(currency, value) {
        if (!isFinite(value) || value <= 0) return "—";
        if (currency === "LBP") {
            return Math.round(value).toLocaleString("en-US") + " L.L";
        }
        return "$" + value.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function tierLabel(credits) {
        if (credits === 1) return "1 credit";
        if (credits === 2) return "2 credits";
        return "3+ credits";
    }

    function unitPrice(provider, currency) {
        var row = prices[provider];
        if (!row) return 0;
        return Number(currency === "USD" ? row.priceUsd : row.priceLbp) || 0;
    }

    function unitCost(provider, currency, credits) {
        var row = prices[provider];
        if (!row || credits < 1) return 0;
        var isUsd = currency === "USD";
        if (credits === 1) return Number(isUsd ? row.costOneUsd : row.costOneLbp) || 0;
        if (credits === 2) return Number(isUsd ? row.costTwoUsd : row.costTwoLbp) || 0;
        return Number(isUsd ? row.costThreeUsd : row.costThreeLbp) || 0;
    }

    function clampCredits(n) {
        if (!isFinite(n) || n < 1) return 1;
        if (n > 999) return 999;
        return Math.round(n);
    }

    function refreshQuote() {
        var provider = selectedValue("SellForm.Provider") || "Touch";
        var currency = selectedValue("SellForm.Currency") || "USD";
        var credits = clampCredits(parseInt(creditsInput.value, 10) || 0);
        if (String(creditsInput.value) !== String(credits) && creditsInput.value !== "")
            creditsInput.value = String(credits);

        var price = unitPrice(provider, currency);
        var cost = unitCost(provider, currency, credits);
        var saleTotal = price * credits;
        var costTotal = cost * credits;

        tierEl.textContent = credits >= 1 ? tierLabel(credits) : "—";
        unitPriceEl.textContent = formatMoney(currency, price);
        saleTotalEl.textContent = formatMoney(currency, saleTotal);
        unitCostEl.textContent = formatMoney(currency, cost);
        costTotalEl.textContent = formatMoney(currency, costTotal);

        return {
            provider: provider,
            currency: currency,
            credits: credits,
            price: price,
            cost: cost,
            saleTotal: saleTotal,
            costTotal: costTotal
        };
    }

    form.querySelectorAll('input[name="SellForm.Provider"], input[name="SellForm.Currency"]').forEach(function (el) {
        el.addEventListener("change", refreshQuote);
    });
    creditsInput.addEventListener("input", refreshQuote);

    if (minusBtn) {
        minusBtn.addEventListener("click", function () {
            creditsInput.value = String(clampCredits((parseInt(creditsInput.value, 10) || 1) - 1));
            refreshQuote();
            creditsInput.focus();
        });
    }
    if (plusBtn) {
        plusBtn.addEventListener("click", function () {
            creditsInput.value = String(clampCredits((parseInt(creditsInput.value, 10) || 0) + 1));
            refreshQuote();
            creditsInput.focus();
        });
    }

    refreshQuote();

    function openModal() {
        var quote = refreshQuote();
        if (quote.credits < 1 || quote.credits > 999) {
            creditsInput.focus();
            creditsInput.reportValidity();
            return;
        }
        if (!(quote.price > 0) || !(quote.saleTotal > 0)) {
            saleTotalEl.textContent = "Price not set";
            return;
        }
        if (!(quote.cost > 0) || !(quote.costTotal > 0)) {
            costTotalEl.textContent = "Cost not set";
            return;
        }

        var creditWord = quote.credits === 1 ? "credit" : "credits";
        var label = quote.provider + " · " + quote.credits + " " + creditWord;
        var saleDisplay = formatMoney(quote.currency, quote.saleTotal);
        var costDisplay = formatMoney(quote.currency, quote.costTotal);

        summaryLabel.textContent = label;
        summarySale.textContent = saleDisplay;
        summaryCost.textContent = costDisplay;
        descEl.textContent = "Customer pays " + saleDisplay + ". Deduct " + costDisplay + " from the Katsh " + quote.currency + " balance.";

        modal.classList.remove("d-none");
        document.body.classList.add("bk-admin-modal-open");
    }

    function closeModal() {
        modal.classList.add("d-none");
        document.body.classList.remove("bk-admin-modal-open");
    }

    reviewBtn.addEventListener("click", openModal);
    modal.querySelectorAll("[data-katsh-airtime-dismiss]").forEach(function (el) {
        el.addEventListener("click", closeModal);
    });

    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !modal.classList.contains("d-none"))
            closeModal();
    });
})();
</script>
}
