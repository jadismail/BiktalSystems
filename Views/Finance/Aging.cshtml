@{
    ViewData["Title"] = "Aging (AR/AP)";
    ViewData["Module"] = "Finance";
    ViewData["ModuleSubtitle"] = "Customer and supplier balances with buckets.";
}
<div class="container pb-5 pt-3 bk-finance">
    @await Component.InvokeAsync("ModuleNav")

    <partial name="_ModuleHeader" />

    <div class="bk-finance-callout" role="status">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        <div>
            AR/AP aging will pull from open invoices and purchase orders. Manage customer debits under
            <a asp-controller="Installments" asp-action="Index" class="fw-semibold">CRM → Debits</a>.
            For supplier open balances, see
            <a asp-controller="Inventory" asp-action="PurchaseOrders">purchase orders</a>.
        </div>
    </div>

    <ul class="nav nav-pills gap-2 mb-3 bk-finance-pills">
        <li class="nav-item"><span class="nav-link active rounded-pill small">Receivables</span></li>
        <li class="nav-item"><span class="nav-link rounded-pill small text-muted">Payables</span></li>
    </ul>

    <div class="bk-table-wrap bk-finance-table">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Customer</th>
                    <th class="text-end" scope="col">Current</th>
                    <th class="text-end" scope="col">30</th>
                    <th class="text-end" scope="col">60</th>
                    <th class="text-end" scope="col">90+</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="5"><div class="bk-empty">Customer debits and POS credit sales roll up here.</div></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
