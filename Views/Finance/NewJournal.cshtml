@model NewJournalPageViewModel
@{
    ViewData["Title"] = "New journal entry";
    ViewData["Module"] = "Finance";
    ViewData["ModuleSubtitle"] = "Balanced debits and credits across one or more lines.";
}
<div class="container pb-5 pt-3 bk-finance" style="max-width: 960px;">
    @await Component.InvokeAsync("ModuleNav")

    <nav class="bk-finance-bc" aria-label="Breadcrumb">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-action="Journal">Journal entries</a></li>
            <li class="breadcrumb-item active" aria-current="page">New entry</li>
        </ol>
    </nav>

    <partial name="_ModuleHeader" />

    <div class="bk-finance-panel p-4 p-lg-5">
        <div class="bk-finance-panel-title">Post journal</div>
        <form asp-action="CreateJournal" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger small fw-semibold mb-3"></div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Form.EntryDate" class="form-label small fw-bold"></label>
                    <input asp-for="Form.EntryDate" class="form-control" type="date" />
                    <span asp-validation-for="Form.EntryDate" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Form.Memo" class="form-label small fw-bold"></label>
                    <input asp-for="Form.Memo" class="form-control" placeholder="Optional description" />
                    <span asp-validation-for="Form.Memo" class="text-danger small"></span>
                </div>
            </div>

            <p class="small text-muted fw-semibold mb-2">Each line: pick an account and enter either a debit or a credit (not both). Total debits must equal total credits.</p>
            <div class="table-responsive mb-3 bk-finance-lines-grid rounded-3 overflow-hidden">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:14rem">Account</th>
                            <th style="width:8rem" class="text-end">Debit</th>
                            <th style="width:8rem" class="text-end">Credit</th>
                            <th>Line memo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Form.Lines.Count; i++)
                        {
                            <tr>
                                <td>
                                    <select name="Form.Lines[@i].AccountId" class="form-select form-select-sm" title="GL account">
                                        <option value="">—</option>
                                        @foreach (var a in Model.Accounts)
                                        {
                                            if (Model.Form.Lines[i].AccountId == a.Id)
                                            {
                                                <option value="@a.Id" selected>@a.Code - @a.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@a.Id">@a.Code - @a.Name</option>
                                            }
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input name="Form.Lines[@i].Debit" value="@Model.Form.Lines[i].Debit" class="form-control form-control-sm text-end font-monospace" inputmode="decimal" placeholder="0.00" />
                                </td>
                                <td>
                                    <input name="Form.Lines[@i].Credit" value="@Model.Form.Lines[i].Credit" class="form-control form-control-sm text-end font-monospace" inputmode="decimal" placeholder="0.00" />
                                </td>
                                <td>
                                    <input name="Form.Lines[@i].LineMemo" value="@Model.Form.Lines[i].LineMemo" class="form-control form-control-sm" maxlength="512" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary fw-semibold px-4">Post journal</button>
                <a asp-action="Journal" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
