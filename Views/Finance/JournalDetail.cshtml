@model JournalEntryDetailViewModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Reference;
    ViewData["Module"] = "Finance";
    ViewData["ModuleSubtitle"] = "Posted journal entry.";
    var money = CultureInfo.GetCultureInfo("en-US");
}
<div class="container pb-5 pt-3 bk-finance">
    @await Component.InvokeAsync("ModuleNav")

    <nav class="bk-finance-bc" aria-label="Breadcrumb">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-action="Journal">Journal entries</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Reference</li>
        </ol>
    </nav>

    @if (TempData["FinanceMessage"] is string okMsg)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="status">
            <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@okMsg</div>
        </div>
    }

    <div class="bk-finance-journal-head">
        <div>
            <p class="small text-uppercase fw-bold text-muted letter-spacing mb-1">Posted journal</p>
            <h1 class="bk-finance-journal-ref mb-2">@Model.Reference</h1>
            <p class="small text-muted mb-0 fw-semibold">
                <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@Model.EntryDate.ToString("D", money)
                <span class="mx-2">·</span>
                <span>Created @Model.CreatedAtUtc.ToLocalTime().ToString("g", money)</span>
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.Memo))
            {
                <p class="mt-3 mb-0 fw-semibold">@Model.Memo</p>
            }
        </div>
        <a asp-action="Journal" class="btn btn-outline-secondary btn-sm fw-semibold align-self-start">Back to list</a>
    </div>

    <div class="bk-table-wrap bk-finance-table bk-finance-journal-lines">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Account</th>
                        <th scope="col">Memo</th>
                        <th class="text-end" scope="col">Debit</th>
                        <th class="text-end" scope="col">Credit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <span class="font-monospace fw-bold bk-finance-amount-pos">@line.AccountCode</span>
                                <span class="d-block small text-muted">@line.AccountName</span>
                            </td>
                            <td class="small">@(string.IsNullOrWhiteSpace(line.LineMemo) ? "—" : line.LineMemo)</td>
                            <td class="text-end font-monospace">@(line.Debit > 0 ? line.Debit.ToString("N2", money) : "—")</td>
                            <td class="text-end font-monospace">@(line.Credit > 0 ? line.Credit.ToString("N2", money) : "—")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th colspan="2" class="text-end">Totals</th>
                        <th class="text-end font-monospace bk-finance-amount-pos">@Model.TotalDebits.ToString("N2", money)</th>
                        <th class="text-end font-monospace bk-finance-amount-pos">@Model.TotalCredits.ToString("N2", money)</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
