@model CreateStaffMemberFormModel
@{
    ViewData["Title"] = "New team member";
    ViewData["Module"] = "Staff";
    ViewData["ModuleSubtitle"] = "Create an HR profile.";
}
<div class="container pb-5 pt-3 bk-staff" style="max-width: 720px;">
    @await Component.InvokeAsync("ModuleNav")

    <nav class="bk-staff-bc mb-2" aria-label="Breadcrumb">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-action="Team">Team</a></li>
            <li class="breadcrumb-item active" aria-current="page">New</li>
        </ol>
    </nav>

    <partial name="_ModuleHeader" />

    <div class="bk-staff-panel p-4 p-lg-5">
        <div class="bk-staff-panel-title">Member details</div>
        <form asp-action="CreateMember" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger small fw-semibold mb-3"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="DisplayName" class="form-label small fw-bold"></label>
                    <input asp-for="DisplayName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="DisplayName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="JobTitle" class="form-label small fw-bold"></label>
                    <input asp-for="JobTitle" class="form-control" />
                    <span asp-validation-for="JobTitle" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EmployeeCode" class="form-label small fw-bold"></label>
                    <input asp-for="EmployeeCode" class="form-control font-monospace" placeholder="EMP-004" />
                    <span asp-validation-for="EmployeeCode" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="WorkEmail" class="form-label small fw-bold"></label>
                    <input asp-for="WorkEmail" class="form-control" autocomplete="email" />
                    <span asp-validation-for="WorkEmail" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label small fw-bold"></label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HireDate" class="form-label small fw-bold"></label>
                    <input asp-for="HireDate" class="form-control" type="date" />
                    <span asp-validation-for="HireDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HourlyRate" class="form-label small fw-bold"></label>
                    <input asp-for="HourlyRate" class="form-control text-end" inputmode="decimal" />
                    <span asp-validation-for="HourlyRate" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label small fw-bold"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary fw-semibold px-4">Save member</button>
                <a asp-action="Team" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
