@model StaffActivityPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Activity log";
    ViewData["Module"] = "Staff";
    ViewData["ModuleSubtitle"] = "Notable staff and security-adjacent events.";
    var n = CultureInfo.InvariantCulture;
}
<div class="container pb-5 pt-3 bk-staff">
    @await Component.InvokeAsync("ModuleNav")

    <partial name="_ModuleHeader" />

    <div class="bk-table-wrap bk-staff-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>When (UTC)</th>
                        <th>Actor</th>
                        <th>Category</th>
                        <th>Message</th>
                        <th>Related member</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Entries.Count == 0)
                    {
                        <tr>
                            <td colspan="5"><div class="bk-empty">No activity rows yet.</div></td>
                        </tr>
                    }
                    else
                    {
                        foreach (var e in Model.Entries)
                        {
                            <tr>
                                <td class="small font-monospace text-nowrap">@e.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss", n)</td>
                                <td class="fw-semibold small">@e.ActorDisplayName</td>
                                <td><span class="badge text-bg-light border">@StaffActivityCategoryLabels.Title(e.Category)</span></td>
                                <td class="small">@e.Message</td>
                                <td class="small">
                                    @if (e.RelatedStaffMemberId is { } id && !string.IsNullOrEmpty(e.RelatedMemberName))
                                    {
                                        <a asp-action="Member" asp-route-id="@id" class="text-decoration-none">@e.RelatedMemberName</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
