@model InstallmentPlanDetailViewModel
@using System.Globalization
@{
    ViewData["Title"] = Model.PlanNumber;
    ViewData["Module"] = "CRM";
    ViewData["ModuleSubtitle"] = Model.Description;
    var money = CultureInfo.GetCultureInfo("en-US");
    var paidPct = Model.TotalAmount > 0m
        ? Math.Clamp((double)(Model.AmountPaid / Model.TotalAmount) * 100d, 0d, 100d)
        : 0d;
    var canRecordPayment = Model.Status == Biktal.Domain.Crm.InstallmentPlanStatus.Active && Model.BalanceDue > 0m;
}
<div class="container pb-5 pt-3 bk-crm">
    @await Component.InvokeAsync("ModuleNav")

    <nav class="bk-crm-bc mb-2" aria-label="Breadcrumb">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-action="Index">Debits</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.PlanNumber</li>
        </ol>
    </nav>

    @if (TempData["CrmMessage"] is string okMsg)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="status">
            <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@okMsg</div>
        </div>
    }
    @if (TempData["CrmError"] is string errMsg)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@errMsg</div>
        </div>
    }

    <header class="bk-crm-debit-head mb-4">
        <div class="bk-crm-debit-head-main">
            <p class="bk-crm-debit-eyebrow mb-1">Customer debit</p>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h1 class="bk-crm-ticket-ref mb-0 font-monospace">@Model.PlanNumber</h1>
                <span class="badge @InstallmentPlanStatusLabels.BadgeClass(Model.Status)">
                    @InstallmentPlanStatusLabels.Title(Model.Status)
                </span>
            </div>
            <h2 class="h5 fw-bold mb-2">@Model.Description</h2>
            <p class="small text-muted mb-0 fw-semibold">
                <a asp-controller="Crm" asp-action="Customer" asp-route-id="@Model.CustomerId" class="fw-semibold text-decoration-none">
                    <i class="bi bi-person me-1" aria-hidden="true"></i>@Model.CustomerName
                </a>
                @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                {
                    <span class="mx-1">·</span>
                    <span>@Model.CustomerPhone</span>
                }
                <span class="mx-1">·</span>
                <span>Opened @Model.StartDate.ToString("MMM d, yyyy", money)</span>
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <p class="small mt-3 mb-0"><span class="fw-bold">Notes:</span> @Model.Notes</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.OpeningJournalReference))
            {
                <p class="small text-muted mt-2 mb-0">
                    Ledger: <span class="font-monospace">@Model.OpeningJournalReference</span>
                </p>
            }
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold align-self-start">Back to debits</a>
    </header>

    <section class="bk-crm-debit-balance mb-4" aria-label="Debit balance">
        <div class="bk-crm-debit-stat">
            <div class="bk-crm-debit-stat-label">Debit total</div>
            <div class="bk-crm-debit-stat-value">@Model.TotalAmount.ToString("C", money)</div>
        </div>
        <div class="bk-crm-debit-stat">
            <div class="bk-crm-debit-stat-label">Down payment</div>
            <div class="bk-crm-debit-stat-value">@Model.DownPayment.ToString("C", money)</div>
        </div>
        <div class="bk-crm-debit-stat">
            <div class="bk-crm-debit-stat-label">Amount paid</div>
            <div class="bk-crm-debit-stat-value">@Model.AmountPaid.ToString("C", money)</div>
        </div>
        <div class="bk-crm-debit-stat bk-crm-debit-stat--accent">
            <div class="bk-crm-debit-stat-label">Balance due</div>
            <div class="bk-crm-debit-stat-value">@Model.BalanceDue.ToString("C", money)</div>
        </div>
        <div class="bk-crm-debit-progress">
            <div class="d-flex justify-content-between small fw-semibold mb-1">
                <span class="text-muted">Collected</span>
                <span>@paidPct.ToString("0", CultureInfo.InvariantCulture)%</span>
            </div>
            <div class="progress bk-crm-debit-bar" role="progressbar" aria-valuenow="@((int)Math.Round(paidPct))" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @paidPct.ToString("0.##", CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
    </section>

    <div class="row g-4">
        @if (canRecordPayment)
        {
            <div class="col-lg-4">
                <div class="bk-crm-panel p-4 h-100 bk-crm-debit-pay">
                    <div class="bk-crm-panel-title">Record payment</div>
                    <p class="small text-muted fw-semibold mb-3">Apply cash, Whish, or card against this debit.</p>
                    <form asp-action="RecordPayment" method="post" class="row g-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PaymentForm.PlanId" />
                        <div class="col-12">
                            <label asp-for="PaymentForm.Amount" class="form-label small fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PaymentForm.Amount" class="form-control" inputmode="decimal" step="0.01" min="0.01"
                                       placeholder="@Model.BalanceDue.ToString("F2", CultureInfo.InvariantCulture)" />
                            </div>
                            <div class="form-text">Balance due: @Model.BalanceDue.ToString("C", money)</div>
                            <span asp-validation-for="PaymentForm.Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="PaymentForm.Method" class="form-label small fw-bold"></label>
                            <select asp-for="PaymentForm.Method" class="form-select">
                                <option value="Cash">Cash</option>
                                <option value="Whish">Whish</option>
                                <option value="Card">Card</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="PaymentForm.Notes" class="form-label small fw-bold"></label>
                            <input asp-for="PaymentForm.Notes" class="form-control" placeholder="Optional receipt note" />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary fw-semibold w-100">
                                <i class="bi bi-cash-coin me-1" aria-hidden="true"></i>Post payment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <div class="@(canRecordPayment ? "col-lg-8" : "col-12")">
            <div class="bk-crm-panel p-4 h-100">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div class="bk-crm-panel-title mb-0">Payment history</div>
                    <span class="small text-muted fw-semibold">@Model.Payments.Count payment(s)</span>
                </div>

                @if (Model.Payments.Count == 0)
                {
                    <div class="bk-empty py-4">No payments recorded yet.</div>
                }
                else
                {
                    <div class="table-responsive bk-crm-table">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Date</th>
                                    <th scope="col">Method</th>
                                    <th class="text-end" scope="col">Amount</th>
                                    <th scope="col">Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Payments)
                                {
                                    <tr>
                                        <td class="small">@p.ReceivedAtUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt", money)</td>
                                        <td>
                                            <span class="badge text-bg-light border">@p.Method</span>
                                        </td>
                                        <td class="text-end font-monospace fw-bold">@p.Amount.ToString("C", money)</td>
                                        <td class="small text-muted">@(string.IsNullOrWhiteSpace(p.Notes) ? "—" : p.Notes)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
