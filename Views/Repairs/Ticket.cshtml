@model RepairTicketDetailViewModel
@using System.Globalization
@using Biktal.Domain.Repairs
@{
    ViewData["Title"] = Model.TicketNumber;
    ViewData["Module"] = "Repairs";
    ViewData["ModuleSubtitle"] = "Ticket detail and workflow.";
    var money = CultureInfo.GetCultureInfo("en-US");
    string StatusBadgeClass(RepairTicketStatus s) => s switch
    {
        RepairTicketStatus.Intake => "text-bg-secondary",
        RepairTicketStatus.Inspection => "text-bg-info",
        RepairTicketStatus.WaitingParts => "text-bg-warning",
        RepairTicketStatus.InRepair => "text-bg-primary",
        RepairTicketStatus.ReadyForPickup => "text-bg-success",
        RepairTicketStatus.Delivered => "text-bg-success",
        RepairTicketStatus.Cancelled => "text-bg-dark",
        _ => "text-bg-light border"
    };
}

<div class="container pb-5 pt-3">
    @await Component.InvokeAsync("ModuleNav")

    <nav class="mb-2" aria-label="Breadcrumb">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-action="Tickets">Tickets</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.TicketNumber</li>
        </ol>
    </nav>

    @if (TempData["RepairMessage"] is string okMsg)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="status">
            <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@okMsg</div>
        </div>
    }
    @if (TempData["RepairError"] is string errMsg)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@errMsg</div>
        </div>
    }

    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h4 fw-bold mb-2 font-monospace">@Model.TicketNumber</h1>
            <span class="badge @StatusBadgeClass(Model.Status)">@RepairTicketStatusLabels.Title(Model.Status)</span>
            <p class="small text-muted mb-0 mt-2 fw-semibold">
                <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>Created @Model.CreatedAtUtc.ToLocalTime().ToString("g", money)
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Tickets" class="btn btn-outline-secondary btn-sm">Back to board</a>
            <a asp-action="New" class="btn btn-primary btn-sm">New check-in</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="bk-card p-4 mb-4">
                <h2 class="h6 fw-bold text-uppercase letter-spacing text-muted mb-3">Device &amp; issue</h2>
                <dl class="row small mb-0">
                    <dt class="col-sm-4 text-muted fw-semibold">Device</dt>
                    <dd class="col-sm-8 fw-semibold mb-2">@Model.DeviceSummary</dd>
                    <dt class="col-sm-4 text-muted fw-semibold">IMEI / serial</dt>
                    <dd class="col-sm-8 mb-2">@(string.IsNullOrWhiteSpace(Model.SerialOrImei) ? "—" : Model.SerialOrImei)</dd>
                    <dt class="col-sm-4 text-muted fw-semibold">Device barcode</dt>
                    <dd class="col-sm-8 mb-2 font-monospace">@(string.IsNullOrWhiteSpace(Model.Barcode) ? "—" : Model.Barcode)</dd>
                    <dt class="col-sm-4 text-muted fw-semibold">Issue</dt>
                    <dd class="col-sm-8 mb-2">@Model.IssueDescription</dd>
                    <dt class="col-sm-4 text-muted fw-semibold">Accessories</dt>
                    <dd class="col-sm-8 mb-0">@(string.IsNullOrWhiteSpace(Model.AccessoriesNotes) ? "—" : Model.AccessoriesNotes)</dd>
                </dl>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Barcode))
            {
                <div class="bk-card p-4 mb-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            <h2 class="h6 fw-bold text-uppercase letter-spacing text-muted mb-1">Device barcode label</h2>
                            <p class="small text-muted mb-0 fw-semibold">Reprint the sticker for this phone.</p>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm fw-semibold" id="bk-repair-barcode-print">
                            <i class="bi bi-printer me-1" aria-hidden="true"></i>Print label
                        </button>
                    </div>
                    <div class="bk-repair-barcode-preview">
                        <svg id="bk-repair-barcode-svg"></svg>
                        <div class="bk-repair-barcode-meta">
                            <div class="font-monospace fw-bold">@Model.Barcode</div>
                            <span class="bk-repair-barcode-line">@Model.DeviceSummary</span>
                            <span class="bk-repair-barcode-line">@Model.CustomerName</span>
                        </div>
                    </div>
                </div>
            }
            <div class="bk-card p-4">
                <h2 class="h6 fw-bold text-uppercase letter-spacing text-muted mb-3">Customer</h2>
                <dl class="row small mb-0">
                    <dt class="col-sm-4 text-muted fw-semibold">Name</dt>
                    <dd class="col-sm-8 fw-semibold mb-2">@Model.CustomerName</dd>
                    <dt class="col-sm-4 text-muted fw-semibold">Phone</dt>
                    <dd class="col-sm-8 mb-2">@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</dd>
                    <dt class="col-sm-4 text-muted fw-semibold">Email</dt>
                    <dd class="col-sm-8 mb-0">@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</dd>
                </dl>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="bk-card p-4 mb-4">
                <h2 class="h6 fw-bold text-uppercase letter-spacing text-muted mb-3">Pricing & margin</h2>
                @if (Model.MarginAmount is { } margin)
                {
                    <div class="d-flex justify-content-between align-items-baseline mb-3 p-3 rounded bg-light">
                        <span class="small fw-semibold text-muted">Estimated margin</span>
                        <span class="h5 mb-0 font-monospace fw-bold">@margin.ToString("C", money)</span>
                    </div>
                    @if (Model.MarginPercent is { } mp)
                    {
                        <p class="small text-muted mb-3">@mp.ToString("N1", CultureInfo.InvariantCulture)% of customer quote</p>
                    }
                }
                @if (Model.IsPostedToAccounts)
                {
                    <div class="alert alert-success border-0 py-2 small mb-3" role="status">
                        Posted to Accounts — Cash @Model.AmountPaidCash.ToString("C", money),
                        Whish @Model.AmountPaidWhish.ToString("C", money).
                    </div>
                }
                <form asp-action="UpdateTicketEstimate" method="post" class="mb-0" id="bk-repair-pricing-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <fieldset @(Model.IsPostedToAccounts ? "disabled" : null)>
                        <label for="repair-estimated-price" class="form-label small fw-semibold text-muted">Customer quote (USD)</label>
                        <div class="input-group input-group-lg mb-3">
                            <span class="input-group-text">$</span>
                            <input type="text"
                                   class="form-control font-monospace"
                                   id="repair-estimated-price"
                                   name="estimatedPrice"
                                   inputmode="decimal"
                                   placeholder="e.g. 149.99"
                                   value="@(Model.EstimatedPrice?.ToString("0.00", CultureInfo.InvariantCulture) ?? "")"
                                   autocomplete="off" />
                        </div>
                        <label for="repair-parts-cost" class="form-label small fw-semibold text-muted">Parts cost (USD)</label>
                        <div class="input-group input-group-lg mb-3">
                            <span class="input-group-text">$</span>
                            <input type="text"
                                   class="form-control font-monospace"
                                   id="repair-parts-cost"
                                   name="partsCost"
                                   inputmode="decimal"
                                   placeholder="e.g. 45.00"
                                   value="@(Model.PartsCost?.ToString("0.00", CultureInfo.InvariantCulture) ?? "")"
                                   autocomplete="off" />
                        </div>
                        <div class="border-top pt-3 mb-3">
                            <p class="small fw-semibold text-muted mb-2">Payment at delivery (like POS)</p>
                            <p class="small text-muted mb-3">Cash + Whish must equal the customer quote before marking Delivered.</p>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label for="repair-paid-cash" class="form-label small fw-semibold text-muted">Cash</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="text"
                                               class="form-control font-monospace"
                                               id="repair-paid-cash"
                                               name="amountPaidCash"
                                               inputmode="decimal"
                                               placeholder="0.00"
                                               value="@(Model.AmountPaidCash > 0m ? Model.AmountPaidCash.ToString("0.00", CultureInfo.InvariantCulture) : "")"
                                               autocomplete="off" />
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label for="repair-paid-whish" class="form-label small fw-semibold text-muted">Whish</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="text"
                                               class="form-control font-monospace"
                                               id="repair-paid-whish"
                                               name="amountPaidWhish"
                                               inputmode="decimal"
                                               placeholder="0.00"
                                               value="@(Model.AmountPaidWhish > 0m ? Model.AmountPaidWhish.ToString("0.00", CultureInfo.InvariantCulture) : "")"
                                               autocomplete="off" />
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="bk-repair-pay-all-cash">All cash</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="bk-repair-pay-all-whish">All Whish</button>
                            </div>
                        </div>
                        <p class="small text-muted mb-3">Save pricing any time. Delivered posts Cash/Whish into Accounts.</p>
                        <button type="submit" class="btn btn-primary btn-sm fw-semibold">Save pricing</button>
                    </fieldset>
                </form>
            </div>
            <div class="bk-card p-4 mb-4">
                <h2 class="h6 fw-bold text-uppercase letter-spacing text-muted mb-3">Change status</h2>
                <p class="small text-muted fw-semibold mb-3">Move this ticket to any workflow stage.</p>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (RepairTicketStatus s in Enum.GetValues<RepairTicketStatus>())
                    {
                        if (s == Model.Status)
                        {
                            continue;
                        }

                        if (s == RepairTicketStatus.Delivered)
                        {
                            if (Model.IsPostedToAccounts)
                            {
                                continue;
                            }
                            <form asp-action="DeliverTicket" method="post" class="d-inline" data-repair-deliver>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="amountPaidCash" value="" />
                                <input type="hidden" name="amountPaidWhish" value="" />
                                <button type="submit" class="btn btn-success btn-sm fw-semibold">Delivered</button>
                            </form>
                            continue;
                        }

                        <form asp-action="UpdateTicketStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="@((int)s)" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm fw-semibold">@RepairTicketStatusLabels.Title(s)</button>
                        </form>
                    }
                </div>
            </div>
            @if (Model.CanDelete)
            {
                <div class="bk-card p-4 border-danger border-opacity-25">
                    <h2 class="h6 fw-bold text-uppercase letter-spacing text-danger mb-3">Remove ticket</h2>
                    <p class="small text-muted mb-3">Only intake or cancelled tickets can be permanently removed.</p>
                    <form asp-action="DeleteRepairTicket" method="post" onsubmit="return confirm('Delete this ticket? This cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm fw-semibold">Delete ticket</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var quoteEl = document.getElementById('repair-estimated-price');
        var cashEl = document.getElementById('repair-paid-cash');
        var whishEl = document.getElementById('repair-paid-whish');
        var allCashBtn = document.getElementById('bk-repair-pay-all-cash');
        var allWhishBtn = document.getElementById('bk-repair-pay-all-whish');

        function quoteValue() {
          if (!quoteEl) return '';
          return (quoteEl.value || '').trim();
        }

        if (allCashBtn && cashEl && whishEl) {
          allCashBtn.addEventListener('click', function () {
            cashEl.value = quoteValue();
            whishEl.value = '';
          });
        }
        if (allWhishBtn && cashEl && whishEl) {
          allWhishBtn.addEventListener('click', function () {
            whishEl.value = quoteValue();
            cashEl.value = '';
          });
        }

        document.querySelectorAll('form[data-repair-deliver]').forEach(function (form) {
          form.addEventListener('submit', function () {
            var cashInput = form.querySelector('input[name="amountPaidCash"]');
            var whishInput = form.querySelector('input[name="amountPaidWhish"]');
            if (cashInput) cashInput.value = cashEl ? cashEl.value : '';
            if (whishInput) whishInput.value = whishEl ? whishEl.value : '';
          });
        });
      });
    </script>
    @if (!string.IsNullOrWhiteSpace(Model.Barcode))
    {
        <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
        <script src="~/js/repair-barcode.js" asp-append-version="true"></script>
        <script>
          document.addEventListener('DOMContentLoaded', function () {
            window.BiktalRepairBarcode.initDetail({
              code: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Barcode)),
              device: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeviceSummary)),
              customer: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CustomerName)),
              autoPrint: @(ViewData["PrintBarcode"] is true ? "true" : "false")
            });
          });
        </script>
    }
}
