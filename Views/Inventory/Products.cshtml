@model Biktal.WebMVC.Models.ProductsPageViewModel
@using System.Globalization
@using System.Net
@{
    ViewData["Title"] = "Products";
    ViewData["Module"] = "Inventory";
    var money = CultureInfo.GetCultureInfo("en-US");
}

<div class="container pb-5 pt-3 bk-products-page">
    @await Component.InvokeAsync("ModuleNav")

    <partial name="_ModuleHeader" />

    @if (TempData["ProductMessage"] is string productMsg)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="status">
            <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@productMsg</div>
        </div>
    }
    @if (TempData["ProductError"] is string productErr)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@productErr</div>
        </div>
    }

    <div class="bk-inv-toolbar bk-products-toolbar bk-card p-3 p-md-4 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="flex-grow-1 min-w-0">
            <h2 class="h5 fw-bold mb-2">Catalog</h2>
            <div class="d-flex flex-wrap align-items-center gap-2 gap-md-3">
                <p class="small text-muted mb-0 fw-semibold">
                    <span id="bk-products-count-meta" data-total="@Model.Products.Count">
                        <strong>@Model.Products.Count</strong> @(Model.Products.Count == 1 ? "product" : "products")
                    </span>
                </p>
                @if (Model.Products.Count > 0)
                {
                    @if (Model.AverageMarginPercent is decimal avgMargin)
                    {
                        var marginCls = avgMargin < 0 ? "bk-products-stat-value--neg" : avgMargin == 0 ? "bk-products-stat-value--zero" : "bk-products-stat-value--pos";
                        <div class="bk-products-stat bk-products-stat-margin" role="status" title="Average markup on cost — (price − cost) ÷ cost × 100 — across products with cost greater than zero.">
                            <i class="bi bi-graph-up-arrow bk-products-stat-icon" aria-hidden="true"></i>
                            <div class="bk-products-stat-body">
                                <span class="bk-products-stat-label">Avg margin</span>
                                <span class="bk-products-stat-value font-monospace @marginCls">@avgMargin.ToString("N1", money)%</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bk-products-stat bk-products-stat-muted" role="status" title="Set cost above zero on products to include them in the portfolio average.">
                            <i class="bi bi-dash-circle bk-products-stat-icon" aria-hidden="true"></i>
                            <div class="bk-products-stat-body">
                                <span class="bk-products-stat-label">Avg margin</span>
                                <span class="bk-products-stat-value font-monospace text-muted">—</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        @if (Model.CategoryOptions.Count == 0)
        {
            <button type="button" class="btn btn-secondary fw-semibold px-4" disabled title="Create at least one category first.">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add product
            </button>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Import" class="btn btn-outline-primary fw-semibold px-3">
                    <i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>Import Excel
                </a>
                <button type="button" class="btn btn-primary fw-semibold px-4" data-bs-toggle="modal" data-bs-target="#bk-add-product-modal" id="bk-open-add-product">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add product
                </button>
            </div>
        }
    </div>

    @if (Model.CategoryOptions.Count == 0)
    {
        <div class="alert alert-info border-0 shadow-sm mb-4" role="status">
            <i class="bi bi-folder-plus me-2" aria-hidden="true"></i>
            <strong>Categories required.</strong> Go to <a asp-action="Categories" class="alert-link fw-semibold">Inventory → Categories</a> and add at least one category before you can add products here.
        </div>
    }

    @if (Model.Products.Count > 0)
    {
        <div class="bk-products-search bk-card p-3 p-md-3 mb-3">
            <div class="bk-products-search-form d-flex flex-column flex-sm-row gap-2 align-items-stretch align-items-sm-center" role="search" aria-label="Filter catalog">
                <label for="bk-products-search-q" class="visually-hidden">Filter products</label>
                <div class="input-group flex-grow-1">
                    <span class="input-group-text bg-transparent border-end-0" aria-hidden="true"><i class="bi bi-search"></i></span>
                    <input type="search"
                           id="bk-products-search-q"
                           class="form-control border-start-0 ps-0"
                           autocomplete="off"
                           placeholder="Filter by SKU, name, barcode, category, or brand…"
                           maxlength="200" />
                    <button type="button" class="btn btn-outline-secondary fw-semibold px-3 d-none" id="bk-products-search-clear" aria-label="Clear filter">Clear</button>
                </div>
            </div>
            <p class="small text-muted mb-0 mt-2 fw-semibold">Results update as you type. Separate words narrow the list (all words must match).</p>
        </div>
    }

    <div class="bk-table-wrap bk-products-table-wrap">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th class="text-end" scope="col">Price</th>
                        <th scope="col">Category</th>
                        <th scope="col">Brand</th>
                        <th class="text-end" scope="col">Stock</th>
                        <th scope="col">SKU</th>
                        <th scope="col">Barcode</th>
                        <th class="text-end" scope="col">Cost</th>
                        <th class="text-end" scope="col">Margin</th>
                        <th class="text-end" scope="col" style="width:5rem">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products.Count == 0)
                    {
                        <tr>
                            <td colspan="10">
                                <div class="bk-empty py-5">
                                    <i class="bi bi-inboxes d-block fs-1 mb-2 opacity-50" aria-hidden="true"></i>
                                    <p class="fw-semibold mb-1">No products yet</p>
                                    <p class="small text-muted mb-0">Click <strong>Add product</strong> to open the form and create your first SKU.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in Model.Products)
                        {
                            var margin = ProductCatalogDisplay.MarkupOnCostPercent(p.Price, p.Cost);
                            var searchHaystack = $"{p.Sku} {p.Barcode ?? ""} {p.Name} {p.Category} {p.Brand?.Name ?? ""}".ToLowerInvariant();
                            <tr class="bk-product-row" data-bk-search="@WebUtility.HtmlEncode(searchHaystack)">
                                <td class="fw-semibold">@p.Name</td>
                                <td class="text-end font-monospace small">@p.Price.ToString("C2", money)</td>
                                <td><span class="badge rounded-pill text-bg-light border">@p.Category</span></td>
                                <td>
                                    @if (p.Brand is null)
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-light border text-secondary">@p.Brand.Name</span>
                                    }
                                </td>
                                <td class="text-end font-monospace @(p.StockQuantity <= 0 ? "text-danger fw-bold" : null)">@p.StockQuantity.ToString("N0", money)</td>
                                <td class="font-monospace small fw-semibold text-nowrap">@p.Sku</td>
                                <td class="font-monospace small">
                                    @if (string.IsNullOrWhiteSpace(p.Barcode))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        @p.Barcode
                                    }
                                </td>
                                <td class="text-end font-monospace small">@p.Cost.ToString("C2", money)</td>
                                <td class="text-end font-monospace small fw-semibold">
                                    @if (margin is null)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        var cls = margin.Value < 0 ? "text-danger" : margin.Value == 0 ? "text-muted" : "text-success";
                                        <span class="@cls">@margin.Value.ToString("N1", money)%</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1 justify-content-end">
                                        <a asp-action="Products" asp-route-editId="@p.Id" class="btn btn-sm btn-outline-primary" title="Edit @p.Name">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                            <span class="visually-hidden">Edit</span>
                                        </a>
                                        <form asp-action="DeleteProduct" method="post" class="d-inline" onsubmit="return confirm(@Html.Raw(Json.Serialize($"Delete “{p.Name}” ({p.Sku})? This cannot be undone.")));">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete @p.Name">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                                <span class="visually-hidden">Delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        <tr id="bk-products-filter-empty" class="d-none" aria-live="polite">
                            <td colspan="10">
                                <div class="bk-empty py-4">
                                    <i class="bi bi-search d-block fs-3 mb-2 opacity-50" aria-hidden="true"></i>
                                    <p class="fw-semibold mb-1 small">No rows match this filter</p>
                                    <p class="small text-muted mb-0">Clear the box or try different keywords.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit product modal -->
@if (Model.EditProduct is not null)
{
    var edit = Model.EditProduct;
    <div class="modal fade" id="bk-edit-product-modal" tabindex="-1" aria-labelledby="bk-edit-product-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h2 class="modal-title h5 fw-bold" id="bk-edit-product-modal-title">Edit product</h2>
                        <p class="small text-muted mb-0 fw-semibold">Update SKU, pricing, stock, category, and brand for <span class="font-monospace">@edit.Sku</span>.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-3">
                    <form asp-action="EditProduct" method="post" id="bk-edit-product-form">
                        <input type="hidden" asp-for="EditProduct.ProductId" />
                        @if (ViewData.ModelState.ErrorCount > 0 && Model.OpenEditProductModal)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3" role="alert"></div>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="EditProduct.Sku" class="form-label fw-semibold small"></label>
                                <input asp-for="EditProduct.Sku" class="form-control font-monospace" autocomplete="off" />
                                <span asp-validation-for="EditProduct.Sku" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EditProduct.Barcode" class="form-label fw-semibold small"></label>
                                <input asp-for="EditProduct.Barcode" class="form-control font-monospace" autocomplete="off" placeholder="UPC / EAN (optional)" />
                                <span asp-validation-for="EditProduct.Barcode" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="EditProduct.Name" class="form-label fw-semibold small"></label>
                                <input asp-for="EditProduct.Name" class="form-control" />
                                <span asp-validation-for="EditProduct.Name" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EditProduct.Category" class="form-label fw-semibold small"></label>
                                <select asp-for="EditProduct.Category" class="form-select" required>
                                    <option value="">Choose category…</option>
                                    @foreach (var c in Model.CategoryOptions)
                                    {
                                        <option value="@c.Name">@c.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="EditProduct.Category" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EditProduct.BrandId" class="form-label fw-semibold small"></label>
                                @if (Model.BrandOptions.Count == 0)
                                {
                                    <select class="form-select" disabled aria-disabled="true">
                                        <option>No brands</option>
                                    </select>
                                }
                                else
                                {
                                    <select asp-for="EditProduct.BrandId" class="form-select">
                                        <option value="">No brand</option>
                                        @foreach (var b in Model.BrandOptions)
                                        {
                                            <option value="@b.Id">@b.Name</option>
                                        }
                                    </select>
                                }
                                <span asp-validation-for="EditProduct.BrandId" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="EditProduct.Cost" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="EditProduct.Cost" class="form-control" type="number" min="0" max="999999.99" step="0.01" />
                                </div>
                                <span asp-validation-for="EditProduct.Cost" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="EditProduct.Price" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="EditProduct.Price" class="form-control" type="number" min="0" max="999999.99" step="0.01" />
                                </div>
                                <span asp-validation-for="EditProduct.Price" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EditProduct.StockQuantity" class="form-label fw-semibold small"></label>
                                <input asp-for="EditProduct.StockQuantity" class="form-control" type="number" min="0" max="99999999" step="1" />
                                <span asp-validation-for="EditProduct.StockQuantity" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <form asp-action="DeleteProduct" method="post" class="me-auto" onsubmit="return confirm(@Html.Raw(Json.Serialize($"Delete “{edit.Name}” ({edit.Sku})? This cannot be undone.")));">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@edit.ProductId" />
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete product
                        </button>
                    </form>
                    <a asp-action="Products" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" form="bk-edit-product-form" class="btn btn-primary fw-semibold px-4">
                        <i class="bi bi-check2 me-1" aria-hidden="true"></i>Save changes
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Add product modal -->
<div class="modal fade" id="bk-add-product-modal" tabindex="-1" aria-labelledby="bk-add-product-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h2 class="modal-title h5 fw-bold" id="bk-add-product-modal-title">Add product</h2>
                    <p class="small text-muted mb-0 fw-semibold">Choose SKU, pricing, stock, <strong>category</strong> (required), and optionally a <strong>brand</strong> from your list. Barcode optional.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <form asp-action="AddProduct" method="post" id="bk-add-product-form">
                    @if (ViewData.ModelState.ErrorCount > 0 && Model.OpenAddProductModal)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3" role="alert"></div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="NewProduct.Sku" class="form-label fw-semibold small"></label>
                            <input asp-for="NewProduct.Sku" class="form-control" autocomplete="off" placeholder="e.g. PHONE-16-128" />
                            <span asp-validation-for="NewProduct.Sku" class="text-danger small d-block mt-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewProduct.Barcode" class="form-label fw-semibold small"></label>
                            <input asp-for="NewProduct.Barcode" class="form-control font-monospace" autocomplete="off" placeholder="UPC / EAN (optional)" />
                            <span asp-validation-for="NewProduct.Barcode" class="text-danger small d-block mt-1"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="NewProduct.Name" class="form-label fw-semibold small"></label>
                            <input asp-for="NewProduct.Name" class="form-control" placeholder="Display name on receipts" />
                            <span asp-validation-for="NewProduct.Name" class="text-danger small d-block mt-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewProduct.Category" class="form-label fw-semibold small"></label>
                            @if (Model.CategoryOptions.Count == 0)
                            {
                                <select class="form-select" disabled aria-disabled="true">
                                    <option>No categories — add some under Categories first</option>
                                </select>
                            }
                            else
                            {
                                <select asp-for="NewProduct.Category" class="form-select" required>
                                    <option value="">Choose category…</option>
                                    @foreach (var c in Model.CategoryOptions)
                                    {
                                        <option value="@c.Name">@c.Name</option>
                                    }
                                </select>
                            }
                            <span asp-validation-for="NewProduct.Category" class="text-danger small d-block mt-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewProduct.BrandId" class="form-label fw-semibold small"></label>
                            @if (Model.BrandOptions.Count == 0)
                            {
                                <select class="form-select" disabled aria-disabled="true">
                                    <option>No brands — add under Inventory → Brands (optional)</option>
                                </select>
                            }
                            else
                            {
                                <select asp-for="NewProduct.BrandId" class="form-select">
                                    <option value="">No brand</option>
                                    @foreach (var b in Model.BrandOptions)
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                </select>
                            }
                            <span asp-validation-for="NewProduct.BrandId" class="text-danger small d-block mt-1"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="NewProduct.Cost" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="NewProduct.Cost" class="form-control" type="number" min="0" max="999999.99" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="NewProduct.Cost" class="text-danger small d-block mt-1"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="NewProduct.Price" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="NewProduct.Price" class="form-control" type="number" min="0" max="999999.99" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="NewProduct.Price" class="text-danger small d-block mt-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewProduct.StockQuantity" class="form-label fw-semibold small"></label>
                            <input asp-for="NewProduct.StockQuantity" class="form-control" type="number" min="0" max="99999999" step="1" />
                            <span asp-validation-for="NewProduct.StockQuantity" class="text-danger small d-block mt-1"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <p class="small text-muted mb-0 fw-semibold">
                                <i class="bi bi-calculator me-1" aria-hidden="true"></i>Example: cost $5, price $10 → margin <strong>100%</strong> on cost.
                            </p>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="bk-add-product-form" class="btn btn-primary fw-semibold px-4" @(Model.CategoryOptions.Count == 0 ? "disabled" : null)>
                    <i class="bi bi-check2 me-1" aria-hidden="true"></i>Save product
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.OpenAddProductModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalEl = document.getElementById('bk-add-product-modal');
                if (modalEl && window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            });
        </script>
    }
    @if (Model.OpenEditProductModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalEl = document.getElementById('bk-edit-product-modal');
                if (modalEl && window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            });
        </script>
    }
    @if (Model.Products.Count > 0)
    {
        <script src="~/js/products-catalog-filter.js" asp-append-version="true"></script>
    }
}
