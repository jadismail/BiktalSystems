@model Biktal.WebMVC.Models.PurchaseOrdersPageViewModel
@using System.Globalization
@using Biktal.Domain.Inventory
@{
    var money = CultureInfo.GetCultureInfo("en-US");
    string StatusBadgeClass(PurchaseOrderStatus s) => s switch
    {
        PurchaseOrderStatus.Draft => "text-bg-secondary",
        PurchaseOrderStatus.Open => "text-bg-primary",
        PurchaseOrderStatus.Received => "text-bg-success",
        PurchaseOrderStatus.Cancelled => "text-bg-dark",
        _ => "text-bg-light border"
    };
}

<div class="container pb-5 pt-3 bk-po-page">
    @await Component.InvokeAsync("ModuleNav")

    <partial name="_ModuleHeader" />

    @if (TempData["PoMessage"] is string okMsg)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="status">
            <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@okMsg</div>
        </div>
    }
    @if (TempData["PoError"] is string errMsg)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@errMsg</div>
        </div>
    }

    <div class="bk-inv-toolbar bk-card p-3 p-md-4 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h2 class="h5 fw-bold mb-1">Open purchase orders</h2>
            <p class="small text-muted mb-0 fw-semibold">Create a draft, add catalog lines, submit when sent to the supplier, then receive into <a asp-action="Stock" class="fw-semibold">Stock</a>.</p>
        </div>
        <button type="button" class="btn btn-primary fw-semibold px-4" data-bs-toggle="modal" data-bs-target="#bk-create-po-modal">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New purchase order
        </button>
    </div>

    <div class="bk-table-wrap">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">PO #</th>
                        <th scope="col">Supplier</th>
                        <th scope="col">Status</th>
                        <th class="text-end" scope="col">Lines</th>
                        <th class="text-end" scope="col">Total</th>
                        <th scope="col">Created</th>
                        <th class="text-end" scope="col" style="width:10rem">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orders.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="bk-empty py-5">
                                    <i class="bi bi-receipt d-block fs-1 mb-2 opacity-50" aria-hidden="true"></i>
                                    <p class="fw-semibold mb-1">No purchase orders yet</p>
                                    <p class="small text-muted mb-0">Click <strong>New purchase order</strong> to start a draft.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in Model.Orders)
                        {
                            <tr>
                                <td class="font-monospace small fw-semibold">
                                    <a asp-action="PurchaseOrderDetail" asp-route-id="@row.Id" class="text-decoration-none">@row.PoNumber</a>
                                </td>
                                <td class="fw-semibold">@row.SupplierName</td>
                                <td><span class="badge rounded-pill @StatusBadgeClass(row.Status)">@row.Status</span></td>
                                <td class="text-end font-monospace small">@row.LineCount.ToString("N0", money)</td>
                                <td class="text-end font-monospace small">@row.LineTotal.ToString("C2", money)</td>
                                <td class="small text-muted">@row.CreatedAtUtc.ToLocalTime().ToString("g", money)</td>
                                <td class="text-end">
                                    <a asp-action="PurchaseOrderDetail" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary fw-semibold">Open</a>
                                    @if (row.Status == PurchaseOrderStatus.Draft)
                                    {
                                        <form asp-action="DeletePurchaseOrder" method="post" class="d-inline" onsubmit="return confirm('Delete this draft PO? This cannot be undone.');">
                                            <input type="hidden" name="id" value="@row.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete draft"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="bk-create-po-modal" tabindex="-1" aria-labelledby="bk-create-po-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h2 class="modal-title h5 fw-bold" id="bk-create-po-modal-title">New purchase order</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <form asp-action="CreatePurchaseOrder" method="post" id="bk-create-po-form">
                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3" role="alert"></div>
                    }
                    <div class="mb-3">
                        <label asp-for="NewOrder.SupplierId" class="form-label fw-semibold small"></label>
                        <select asp-for="NewOrder.SupplierId" class="form-select">
                            <option value="">— Directory (optional) —</option>
                            @foreach (var s in Model.SupplierOptions)
                            {
                                <option value="@s.Id">@s.Name@(string.IsNullOrEmpty(s.Code) ? "" : $" ({s.Code})")</option>
                            }
                        </select>
                        <span asp-validation-for="NewOrder.SupplierId" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewOrder.SupplierName" class="form-label fw-semibold small"></label>
                        <input asp-for="NewOrder.SupplierName" class="form-control" autocomplete="organization" placeholder="Use when not in directory, or leave blank if you picked above" />
                        <span asp-validation-for="NewOrder.SupplierName" class="text-danger small d-block mt-1"></span>
                        <p class="form-text small mb-0">Pick a directory supplier <strong>or</strong> type a one-off name (one is required).</p>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewOrder.ExpectedDate" class="form-label fw-semibold small"></label>
                        <input asp-for="NewOrder.ExpectedDate" class="form-control" type="date" />
                        <span asp-validation-for="NewOrder.ExpectedDate" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="NewOrder.Notes" class="form-label fw-semibold small"></label>
                        <textarea asp-for="NewOrder.Notes" class="form-control" rows="2" placeholder="Optional — reference, incoterms, buyer…"></textarea>
                        <span asp-validation-for="NewOrder.Notes" class="text-danger small d-block mt-1"></span>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="bk-create-po-form" class="btn btn-primary fw-semibold">Create draft</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.OpenCreateModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var el = document.getElementById('bk-create-po-modal');
                if (el && window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).show();
                }
            });
        </script>
    }
}
