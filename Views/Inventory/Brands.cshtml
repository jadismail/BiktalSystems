@model Biktal.WebMVC.Models.BrandsPageViewModel

<div class="container pb-5 pt-3 bk-brands-page">
    @await Component.InvokeAsync("ModuleNav")

    <partial name="_ModuleHeader" />

    @if (TempData["BrandMessage"] is string okMsg)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="status">
            <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@okMsg</div>
        </div>
    }
    @if (TempData["BrandError"] is string errMsg)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@errMsg</div>
        </div>
    }

    <div class="bk-inv-toolbar bk-card p-3 p-md-4 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h2 class="h5 fw-bold mb-1">Brand catalog</h2>
            <p class="small text-muted mb-0 fw-semibold">@Model.Brands.Count @(Model.Brands.Count == 1 ? "brand" : "brands") · product counts use the optional <strong>Brand</strong> field on each SKU. Manage under <a asp-action="Products" class="fw-semibold">Products</a>.</p>
        </div>
        <button type="button" class="btn btn-primary fw-semibold px-4" data-bs-toggle="modal" data-bs-target="#bk-add-brand-modal" id="bk-open-add-brand">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add brand
        </button>
    </div>

    <div class="bk-table-wrap">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-end" scope="col" style="width:5rem">Sort</th>
                        <th scope="col">Name</th>
                        <th scope="col">Description</th>
                        <th class="text-end" scope="col" style="width:8rem">Products</th>
                        <th class="text-end" scope="col" style="width:7rem">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Brands.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="bk-empty py-5">
                                    <i class="bi bi-award d-block fs-1 mb-2 opacity-50" aria-hidden="true"></i>
                                    <p class="fw-semibold mb-1">No brands yet</p>
                                    <p class="small text-muted mb-0">Click <strong>Add brand</strong> to create Apple, Samsung, or your OEM labels.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in Model.Brands)
                        {
                            <tr>
                                <td class="text-end font-monospace small text-muted">@row.SortOrder</td>
                                <td class="fw-semibold">@row.Name</td>
                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(row.Description) ? "—" : row.Description)</td>
                                <td class="text-end">
                                    @if (row.ProductCount == 0)
                                    {
                                        <span class="badge rounded-pill text-bg-light border">0</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-primary">@row.ProductCount.ToString("N0")</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (row.ProductCount > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Clear this brand on all products first.">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="DeleteBrand" method="post" class="d-inline" onsubmit="return confirm('Delete this brand? This cannot be undone.');">
                                            <input type="hidden" name="id" value="@row.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete brand">
                                                <i class="bi bi-trash3" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="bk-add-brand-modal" tabindex="-1" aria-labelledby="bk-add-brand-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h2 class="modal-title h5 fw-bold" id="bk-add-brand-modal-title">Add brand</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <form asp-action="AddBrand" method="post" id="bk-add-brand-form">
                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3" role="alert"></div>
                    }
                    <div class="mb-3">
                        <label asp-for="NewBrand.Name" class="form-label fw-semibold small"></label>
                        <input asp-for="NewBrand.Name" class="form-control" autocomplete="off" placeholder="e.g. Apple" />
                        <span asp-validation-for="NewBrand.Name" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewBrand.Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="NewBrand.Description" class="form-control" rows="2" placeholder="Optional — internal note"></textarea>
                        <span asp-validation-for="NewBrand.Description" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="NewBrand.SortOrder" class="form-label fw-semibold small"></label>
                        <input asp-for="NewBrand.SortOrder" class="form-control" type="number" step="1" placeholder="Leave blank for auto (end of list)" />
                        <span asp-validation-for="NewBrand.SortOrder" class="text-danger small d-block mt-1"></span>
                        <p class="form-text small mb-0">Lower numbers appear first in this list.</p>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="bk-add-brand-form" class="btn btn-primary fw-semibold">Save brand</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.OpenAddModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var el = document.getElementById('bk-add-brand-modal');
                if (el && window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).show();
                }
            });
        </script>
    }
}
