@model AdminBackupsPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Backups";
    ViewData["Module"] = "Admin";
    ViewData["ModuleSubtitle"] = "Weekly database backups stored on this computer.";
    var n = CultureInfo.InvariantCulture;
    string FormatBytes(long? bytes)
    {
        if (bytes is null or <= 0) return "—";
        var b = (double)bytes.Value;
        string[] units = ["B", "KB", "MB", "GB"];
        var i = 0;
        while (b >= 1024 && i < units.Length - 1) { b /= 1024; i++; }
        return $"{b:0.##} {units[i]}";
    }

    bool IsLocalFile(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes) || string.IsNullOrWhiteSpace(Model.BackupDirectory))
            return false;
        try
        {
            var full = System.IO.Path.GetFullPath(notes.Trim());
            var root = System.IO.Path.GetFullPath(Model.BackupDirectory);
            if (!root.EndsWith(System.IO.Path.DirectorySeparatorChar))
                root += System.IO.Path.DirectorySeparatorChar;
            var name = System.IO.Path.GetFileName(full);
            return full.StartsWith(root, StringComparison.OrdinalIgnoreCase)
                && name.StartsWith("ishop-", StringComparison.OrdinalIgnoreCase)
                && name.EndsWith(".dump", StringComparison.OrdinalIgnoreCase)
                && System.IO.File.Exists(full);
        }
        catch
        {
            return false;
        }
    }
}
<div class="container pb-5 pt-3 bk-admin">
    @await Component.InvokeAsync("ModuleNav")

    <partial name="_ModuleHeader" />

    @if (TempData["AdminMessage"] is string okMsg)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="status">
            <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@okMsg</div>
        </div>
    }
    @if (TempData["AdminError"] is string errMsg)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@errMsg</div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="bk-admin-panel p-4 h-100">
                <h2 class="h6 fw-bold mb-3">Weekly schedule</h2>
                @if (Model.AutomaticBackupsEnabled)
                {
                    <p class="small mb-3">
                        A full database backup is saved on this computer every @Model.IntervalDays days while the app is running.
                        If a week is missed, the next backup runs shortly after the app starts again.
                    </p>
                    @if (Model.WeeklyBackupDue)
                    {
                        <p class="small fw-semibold mb-3">A weekly backup is due and will run automatically.</p>
                    }
                    else if (Model.NextAutomaticBackupUtc is { } next)
                    {
                        <p class="small mb-3">Next automatic backup after <span class="fw-semibold">@next.ToLocalTime().ToString("f", n)</span>.</p>
                    }
                }
                else
                {
                    <p class="small mb-3">Automatic weekly backups are turned off. You can still create one now.</p>
                }
                <label class="form-label small fw-bold" for="backup-folder">Saved on this computer</label>
                <input class="form-control font-monospace small mb-3" id="backup-folder" value="@Model.BackupDirectory" readonly />
                <form asp-action="SaveBackupSchedule" method="post" class="mb-0">
                    @Html.AntiForgeryToken()
                    <label class="form-label small fw-bold" for="backup-notes">Notes</label>
                    <textarea class="form-control mb-3" id="backup-notes" name="BackupScheduleNotes" rows="3">@Model.BackupScheduleNotes</textarea>
                    <button type="submit" class="btn btn-outline-secondary btn-sm fw-semibold">Save schedule notes</button>
                </form>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="bk-card-muted p-4 h-100">
                <h2 class="h6 fw-bold mb-3">Last successful backup</h2>
                @if (Model.LastSuccessfulBackup is { } last)
                {
                    <dl class="row small mb-0">
                        <dt class="col-5 text-muted">When</dt>
                        <dd class="col-7 fw-semibold mb-2">@last.CompletedAtUtc.ToLocalTime().ToString("f", n)</dd>
                        <dt class="col-5 text-muted">Label</dt>
                        <dd class="col-7 fw-semibold mb-2">@last.Label</dd>
                        <dt class="col-5 text-muted">Checksum</dt>
                        <dd class="col-7 font-monospace mb-2 text-break">@(last.Checksum ?? "—")</dd>
                        <dt class="col-5 text-muted">Size</dt>
                        <dd class="col-7 fw-semibold mb-2">@FormatBytes(last.SizeBytes)</dd>
                        <dt class="col-5 text-muted">File</dt>
                        <dd class="col-7 mb-0">
                            @if (IsLocalFile(last.Notes))
                            {
                                <a asp-action="DownloadBackup" asp-route-id="@last.Id" class="fw-semibold">@System.IO.Path.GetFileName(last.Notes)</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </dd>
                    </dl>
                }
                else
                {
                    <div class="bk-empty py-3 mb-0">No successful backup recorded yet.</div>
                }
            </div>
        </div>
    </div>

    <div class="bk-admin-panel p-4 mb-4">
        <div class="bk-admin-panel-title">Create a backup now</div>
        <p class="small text-muted mb-3">Writes a PostgreSQL dump into the folder above. Restore it later with pg_restore.</p>
        <form asp-action="CreateBackup" method="post" class="mb-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary fw-semibold">
                <i class="bi bi-download me-1" aria-hidden="true"></i>Create backup now
            </button>
        </form>
    </div>

    <div class="bk-table-wrap bk-admin-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Completed</th>
                        <th scope="col">Label</th>
                        <th scope="col">Status</th>
                        <th scope="col">File</th>
                        <th scope="col">Checksum</th>
                        <th scope="col">Size</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentBackups.Count == 0)
                    {
                        <tr><td colspan="6"><div class="bk-empty">No backup history.</div></td></tr>
                    }
                    @foreach (var b in Model.RecentBackups)
                    {
                        <tr>
                            <td class="small">@b.CompletedAtUtc.ToLocalTime().ToString("g", n)</td>
                            <td class="fw-semibold">@b.Label</td>
                            <td>
                                @switch (b.Status)
                                {
                                    case AdminBackupStatus.Success:
                                        <span class="badge rounded-pill text-bg-success">Success</span>
                                        break;
                                    case AdminBackupStatus.Failed:
                                        <span class="badge rounded-pill text-bg-danger">Failed</span>
                                        break;
                                    default:
                                        <span class="badge rounded-pill text-bg-warning">In progress</span>
                                        break;
                                }
                            </td>
                            <td class="small">
                                @if (IsLocalFile(b.Notes))
                                {
                                    <a asp-action="DownloadBackup" asp-route-id="@b.Id">@System.IO.Path.GetFileName(b.Notes)</a>
                                }
                                else if (b.Status == AdminBackupStatus.Failed && !string.IsNullOrWhiteSpace(b.Notes))
                                {
                                    <span class="text-danger">@b.Notes</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="font-monospace small text-break">@(b.Checksum ?? "—")</td>
                            <td class="small">@FormatBytes(b.SizeBytes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
