@model InsightsDailyViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Daily insights";
    ViewData["Module"] = "Insights";
    var money = CultureInfo.GetCultureInfo("en-US");
    var pct = CultureInfo.InvariantCulture;
    var inv = CultureInfo.InvariantCulture;
    var maxHourRevenue = Model.Hourly.Count > 0 ? Model.Hourly.Max(h => h.Revenue) : 0m;
}
<div class="container pb-5 pt-3 bk-reports bk-insights">
    @await Component.InvokeAsync("ModuleNav")
    <partial name="_ModuleHeader" />

    <form method="get" class="bk-reports-toolbar mb-3">
        <label for="date" class="fw-semibold small text-muted mb-0">Choose day</label>
        <input type="date" id="date" name="date" value="@Model.DateInputValue" class="form-control form-control-sm" style="max-width: 12rem;" />
        <button type="submit" class="btn btn-primary btn-sm fw-semibold">View</button>
        <span class="badge text-bg-light border fw-semibold ms-auto">@Model.PeriodLabel</span>
    </form>

    <section class="bk-reports-kpis mb-4" aria-label="Daily totals">
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-currency-dollar"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Total revenue</div>
                <div class="bk-reports-kpi-value">@Model.TotalRevenue.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">@Model.PosSaleCount POS · @Model.RepairCount repairs</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="bk-reports-kpi-label">POS sales</div>
                <div class="bk-reports-kpi-value">@Model.PosSales.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">@Model.PosSaleCount transaction(s)</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-tools"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Repair delivered</div>
                <div class="bk-reports-kpi-value">@Model.RepairDelivered.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">@Model.RepairCount ticket(s)</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-piggy-bank"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Gross profit</div>
                <div class="bk-reports-kpi-value">@Model.GrossProfit.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">@Model.GrossProfitPercent.ToString("0.#", pct)% margin</div>
            </div>
        </article>
    </section>

    <div class="bk-reports-panel p-4 mb-4">
        <div class="bk-reports-panel-title">Sales by hour</div>
        <p class="small text-muted fw-semibold mb-3">Revenue per hour (local time) — spot the busiest times of the day.</p>
        @if (maxHourRevenue <= 0m)
        {
            <p class="small text-muted mb-0">No sales recorded on this day.</p>
        }
        else
        {
            <div class="bk-chart bk-chart--scroll">
                <div class="bk-chart-track">
                    @foreach (var b in Model.Hourly)
                    {
                        var h = maxHourRevenue > 0m ? (double)(b.Revenue / maxHourRevenue) * 100d : 0d;
                        <div class="bk-chart-col" title="@b.Label — @b.Revenue.ToString("C0", money) (@b.Count sale(s))">
                            <div class="bk-chart-bars">
                                <div class="bk-chart-bar bk-chart-bar--rev" style="height:@h.ToString("0.##", inv)%"></div>
                            </div>
                            <div class="bk-chart-label">@b.Label</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="bk-reports-panel p-4">
        <div class="bk-reports-panel-title">Transactions log</div>
        <p class="small text-muted fw-semibold mb-3">Every POS sale and delivered repair, in the order they happened.</p>
        @if (Model.Records.Count == 0)
        {
            <p class="small text-muted mb-0">No transactions recorded on this day.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Time</th>
                            <th>Type</th>
                            <th>Reference</th>
                            <th>Details</th>
                            <th>Payment</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Records)
                        {
                            <tr>
                                <td class="font-monospace">@r.TimeUtc.ToLocalTime().ToString("HH:mm")</td>
                                <td>
                                    @if (r.IsPosSale)
                                    {
                                        <span class="badge text-bg-primary">@r.Type</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-info">@r.Type</span>
                                    }
                                </td>
                                <td class="font-monospace small">
                                    @if (r.IsPosSale)
                                    {
                                        <a asp-action="Sale" asp-route-saleNumber="@r.Reference" class="fw-semibold">@r.Reference</a>
                                    }
                                    else
                                    {
                                        @r.Reference
                                    }
                                </td>
                                <td class="fw-semibold">@r.Description</td>
                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(r.PaymentMethod) ? "—" : r.PaymentMethod)</td>
                                <td class="text-end font-monospace">@r.Amount.ToString("C", money)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
