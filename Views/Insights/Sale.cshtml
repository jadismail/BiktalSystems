@model InsightsSaleDetailViewModel
@using System.Globalization
@{
    ViewData["Title"] = Model.SaleNumber;
    ViewData["Module"] = "Insights";
    var money = CultureInfo.GetCultureInfo("en-US");
    var saleDay = DateOnly.FromDateTime(Model.CompletedAtUtc.ToLocalTime().DateTime);
}
<div class="container pb-5 pt-3 bk-reports bk-insights">
    @await Component.InvokeAsync("ModuleNav")

    <nav class="mb-2" aria-label="Breadcrumb">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-action="Daily" asp-route-date="@saleDay.ToString("yyyy-MM-dd")">Daily insights</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.SaleNumber</li>
        </ol>
    </nav>

    <partial name="_ModuleHeader" />

    <div class="bk-reports-panel p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <div class="bk-reports-panel-title mb-1">@Model.SaleNumber</div>
                <p class="small text-muted mb-0 fw-semibold">
                    <i class="bi bi-clock me-1" aria-hidden="true"></i>
                    @Model.CompletedAtUtc.ToLocalTime().ToString("f", money)
                    <span class="mx-2">·</span>
                    @Model.CustomerName
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                    {
                        <span> · @Model.CustomerPhone</span>
                    }
                    <span class="mx-2">·</span>
                    @Model.PaymentMethod
                </p>
            </div>
            <div class="text-end">
                <div class="small text-muted fw-semibold">Total</div>
                <div class="fs-4 font-monospace fw-bold">@Model.TotalAmount.ToString("C", money)</div>
            </div>
        </div>

        <div class="row g-3 small">
            <div class="col-6 col-md-3">
                <div class="text-muted fw-semibold">Subtotal</div>
                <div class="font-monospace fw-bold">@Model.Subtotal.ToString("C", money)</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted fw-semibold">Discount</div>
                <div class="font-monospace fw-bold">@Model.Discount.ToString("C", money)</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted fw-semibold">Tax</div>
                <div class="font-monospace fw-bold">@Model.TaxAmount.ToString("C", money)</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted fw-semibold">Payment</div>
                <div class="fw-bold">@Model.PaymentMethod</div>
            </div>
        </div>
    </div>

    <div class="bk-reports-panel p-4">
        <div class="bk-reports-panel-title">Products sold</div>
        <p class="small text-muted fw-semibold mb-3">Line items on this receipt.</p>
        @if (Model.Lines.Count == 0)
        {
            <p class="small text-muted mb-0">No line items recorded for this sale.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>SKU</th>
                            <th>Product</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit price</th>
                            <th class="text-end">Line total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td class="font-monospace small">@line.Sku</td>
                                <td class="fw-semibold">@line.ProductName</td>
                                <td class="text-end font-monospace">@line.Quantity</td>
                                <td class="text-end font-monospace">@line.UnitPrice.ToString("C", money)</td>
                                <td class="text-end font-monospace">@line.LineTotal.ToString("C", money)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="4" class="text-end">Total</th>
                            <th class="text-end font-monospace">@Model.TotalAmount.ToString("C", money)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>

    <div class="mt-3">
        <a asp-action="Daily" asp-route-date="@saleDay.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm fw-semibold">Back to daily insights</a>
    </div>
</div>
