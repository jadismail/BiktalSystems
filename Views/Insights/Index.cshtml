@model BusinessInsightsHubViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Business insights";
    ViewData["Module"] = "Insights";
    ViewData["ModuleSubtitle"] = "How the business is performing — revenue, margin, expenses, and cash.";
    var money = CultureInfo.GetCultureInfo("en-US");
    var pct = CultureInfo.InvariantCulture;
}
<div class="container pb-5 pt-3 bk-reports bk-insights">
    @await Component.InvokeAsync("ModuleNav")
    <partial name="_ModuleHeader" />

    <div class="bk-reports-toolbar mb-3 d-flex flex-wrap gap-2 align-items-center">
        <span class="badge text-bg-light border fw-semibold">@Model.PeriodLabel</span>
        <a asp-controller="Operations" asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold ms-auto">Operations</a>
    </div>

    <section class="bk-reports-kpis bk-insights-kpis mb-4" aria-label="Business health">
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-currency-dollar"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Total revenue</div>
                <div class="bk-reports-kpi-value">@Model.TotalRevenue.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">Products @Model.ProductRevenue.ToString("C0", money) · services @Model.ServiceRevenue.ToString("C0", money)</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-piggy-bank"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Gross profit</div>
                <div class="bk-reports-kpi-value">@Model.GrossProfit.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">@Model.GrossProfitPercent.ToString("0.#", pct)% margin · net after expenses @Model.NetAfterExpenses.ToString("C0", money)</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-box-seam"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Product margin</div>
                <div class="bk-reports-kpi-value">@Model.ProductMargin.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">@Model.ProductMarginPercent.ToString("0.#", pct)% of product revenue</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-tools"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Service margin</div>
                <div class="bk-reports-kpi-value">@Model.ServiceMargin.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">@Model.ServiceMarginPercent.ToString("0.#", pct)% of repair revenue</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-receipt"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Expenses</div>
                <div class="bk-reports-kpi-value">@Model.ExpensesMtd.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">Logged operating costs MTD</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-safe"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Cash position</div>
                <div class="bk-reports-kpi-value">@Model.CashPosition.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">Cash collected @Model.CashCollectedMtd.ToString("C0", money) − expenses</div>
            </div>
        </article>
    </section>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="bk-reports-panel p-4 h-100">
                <div class="bk-reports-panel-title">Revenue overview</div>
                <p class="small text-muted fw-semibold mb-3">Where revenue comes from and what it costs to deliver.</p>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Source</th>
                                <th class="text-end">Transactions</th>
                                <th class="text-end">Revenue</th>
                                <th class="text-end">Cost</th>
                                <th class="text-end">Margin</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ch in Model.RevenueOverview)
                            {
                                <tr>
                                    <td class="fw-semibold">@ch.Channel</td>
                                    <td class="text-end font-monospace">@ch.TransactionCount.ToString("N0", pct)</td>
                                    <td class="text-end font-monospace">@ch.Revenue.ToString("C", money)</td>
                                    <td class="text-end font-monospace text-muted">@(ch.Cost > 0m ? ch.Cost.ToString("C", money) : "—")</td>
                                    <td class="text-end font-monospace">
                                        @if (ch.IsLive && (ch.Revenue > 0m || ch.Cost > 0m))
                                        {
                                            <span>@ch.MarginAmount.ToString("C", money)</span>
                                            @if (ch.Revenue > 0m)
                                            {
                                                <span class="text-muted small">(@ch.MarginPercent.ToString("N1", pct)%)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (ch.IsLive)
                                        {
                                            <span class="badge text-bg-success">Live</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Soon</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="bk-reports-panel p-4 h-100">
                <div class="bk-reports-panel-title">Expense breakdown</div>
                <p class="small text-muted fw-semibold mb-3">Operating costs by category from the expense log.</p>
                @if (Model.ExpenseBreakdown.Count == 0)
                {
                    <p class="small text-muted mb-0">No expenses logged for this period.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>Category</th><th class="text-end">Entries</th><th class="text-end">Amount</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.ExpenseBreakdown)
                                {
                                    <tr>
                                        <td class="fw-semibold">@row.Category</td>
                                        <td class="text-end font-monospace">@row.Count</td>
                                        <td class="text-end font-monospace">@row.Amount.ToString("C", money)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
