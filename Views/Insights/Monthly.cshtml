@model InsightsMonthlyViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Monthly insights";
    ViewData["Module"] = "Insights";
    var money = CultureInfo.GetCultureInfo("en-US");
    var pct = CultureInfo.InvariantCulture;
    var inv = CultureInfo.InvariantCulture;
    var chartMax = Model.Weekly.Count > 0
        ? Model.Weekly.Max(w => Math.Max(w.Revenue, w.GrossProfit))
        : 0m;
}
<div class="container pb-5 pt-3 bk-reports bk-insights">
    @await Component.InvokeAsync("ModuleNav")
    <partial name="_ModuleHeader" />

    <form method="get" class="bk-reports-toolbar mb-3">
        <label for="period" class="fw-semibold small text-muted mb-0">Choose month</label>
        <input type="month" id="period" name="period" value="@Model.MonthInputValue" class="form-control form-control-sm" style="max-width: 12rem;" />
        <button type="submit" class="btn btn-primary btn-sm fw-semibold">View</button>
        <span class="badge text-bg-light border fw-semibold ms-auto">@Model.PeriodLabel</span>
    </form>

    <section class="bk-reports-kpis bk-insights-kpis mb-4" aria-label="Monthly totals">
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-currency-dollar"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Total revenue</div>
                <div class="bk-reports-kpi-value">@Model.TotalRevenue.ToString("C0", money)</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="bk-reports-kpi-label">POS sales</div>
                <div class="bk-reports-kpi-value">@Model.PosSales.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">@Model.PosSaleCount transaction(s)</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-tools"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Repair delivered</div>
                <div class="bk-reports-kpi-value">@Model.RepairDelivered.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">@Model.RepairCount ticket(s)</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-piggy-bank"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Gross profit</div>
                <div class="bk-reports-kpi-value">@Model.GrossProfit.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">@Model.GrossProfitPercent.ToString("0.#", pct)% margin</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-receipt"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Expenses</div>
                <div class="bk-reports-kpi-value">@Model.Expenses.ToString("C0", money)</div>
            </div>
        </article>
        <article class="bk-reports-kpi">
            <div class="bk-reports-kpi-icon" aria-hidden="true"><i class="bi bi-safe"></i></div>
            <div>
                <div class="bk-reports-kpi-label">Net profit</div>
                <div class="bk-reports-kpi-value @(Model.NetProfit < 0 ? "text-danger" : "")">@Model.NetProfit.ToString("C0", money)</div>
                <div class="bk-reports-kpi-hint">Gross profit − expenses</div>
            </div>
        </article>
    </section>

    <div class="bk-reports-panel p-4 mb-4">
        <div class="bk-reports-panel-title">Revenue &amp; gross profit by week</div>
        <div class="bk-chart-legend mb-3">
            <span class="bk-chart-key"><span class="bk-chart-swatch bk-chart-swatch--rev"></span>Revenue</span>
            <span class="bk-chart-key"><span class="bk-chart-swatch bk-chart-swatch--profit"></span>Gross profit</span>
        </div>
        @if (chartMax <= 0m)
        {
            <p class="small text-muted mb-0">No sales recorded this month.</p>
        }
        else
        {
            <div class="bk-chart">
                <div class="bk-chart-track">
                    @foreach (var w in Model.Weekly)
                    {
                        var rh = chartMax > 0m ? (double)(w.Revenue / chartMax) * 100d : 0d;
                        var ph = chartMax > 0m ? (double)(w.GrossProfit / chartMax) * 100d : 0d;
                        <div class="bk-chart-col">
                            <div class="bk-chart-bars bk-chart-bars--group">
                                <div class="bk-chart-bar bk-chart-bar--rev" style="height:@rh.ToString("0.##", inv)%"
                                     title="@w.Label — Revenue @w.Revenue.ToString("C0", money)"></div>
                                <div class="bk-chart-bar bk-chart-bar--profit" style="height:@ph.ToString("0.##", inv)%"
                                     title="@w.Label — Gross profit @w.GrossProfit.ToString("C0", money)"></div>
                            </div>
                            <div class="bk-chart-label">@w.Label</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <partial name="_InsightsBreakdownPanel" model="@(new InsightsBreakdownPanelViewModel { Title = "Top category · revenue", SelectLabel = "Choose a category", ByProfit = false, Rows = Model.Categories })" />
        </div>
        <div class="col-lg-6">
            <partial name="_InsightsBreakdownPanel" model="@(new InsightsBreakdownPanelViewModel { Title = "Top brand · revenue", SelectLabel = "Choose a brand", ByProfit = false, Rows = Model.Brands })" />
        </div>
        <div class="col-lg-6">
            <partial name="_InsightsBreakdownPanel" model="@(new InsightsBreakdownPanelViewModel { Title = "Top category · profit", SelectLabel = "Choose a category", ByProfit = true, Rows = Model.Categories })" />
        </div>
        <div class="col-lg-6">
            <partial name="_InsightsBreakdownPanel" model="@(new InsightsBreakdownPanelViewModel { Title = "Top brand · profit", SelectLabel = "Choose a brand", ByProfit = true, Rows = Model.Brands })" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-breakdown]').forEach(function (panel) {
            var sel = panel.querySelector('[data-breakdown-select]');
            if (!sel) return;
            function update() {
                var o = sel.options[sel.selectedIndex];
                if (!o) return;
                panel.querySelectorAll('[data-field]').forEach(function (el) {
                    var v = o.getAttribute('data-' + el.getAttribute('data-field'));
                    if (v !== null) el.textContent = v;
                });
            }
            sel.addEventListener('change', update);
            update();
        });
    </script>
}
