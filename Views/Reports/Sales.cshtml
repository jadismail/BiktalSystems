@model ReportsSalesPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Sales reports";
    ViewData["Module"] = "Reports";
    ViewData["ModuleSubtitle"] = "Catalog mix and on-hand retail; POS sales post to Finance automatically.";
    var n = CultureInfo.InvariantCulture;
}
<div class="container pb-5 pt-3 bk-reports">
    @await Component.InvokeAsync("ModuleNav")

    <partial name="_ModuleHeader" />

    <div class="bk-reports-toolbar mb-3">
        <a asp-controller="Pos" asp-action="Index" class="btn btn-primary btn-sm fw-semibold"><i class="bi bi-cash-stack me-1"></i>Open POS</a>
        <a asp-controller="Inventory" asp-action="Products" class="btn btn-outline-secondary btn-sm fw-semibold">Catalog</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold">Reports home</a>
    </div>

    <div class="alert alert-light border shadow-sm small mb-4" role="note">
        <strong>Note:</strong> POS checkout now saves sales and posts GL journals. Tables below still rank <strong>catalog SKUs</strong> by on-hand <strong>retail extension</strong> (price × quantity) for purchasing — a dedicated sales history report is coming next.
    </div>

    <div class="bk-reports-panel p-4 mb-4">
        <div class="bk-reports-panel-title">Top SKUs by stock retail value</div>
        <div class="bk-table-wrap bk-reports-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>SKU</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Retail ext.</th>
                            <th class="text-end">Cost ext.</th>
                            <th class="text-end">Margin ext.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopStockRetailRows.Count == 0)
                        {
                            <tr>
                                <td colspan="7"><div class="bk-empty">No catalog products.</div></td>
                            </tr>
                        }
                        else
                        {
                            foreach (var r in Model.TopStockRetailRows)
                            {
                                <tr>
                                    <td class="font-monospace small">@r.Sku</td>
                                    <td class="fw-semibold">@r.Name</td>
                                    <td class="small text-muted">@r.Category</td>
                                    <td class="text-end font-monospace">@r.StockQuantity.ToString("N0", n)</td>
                                    <td class="text-end font-monospace">@r.LineRetailValue.ToString("N2", n)</td>
                                    <td class="text-end font-monospace text-muted">@r.LineCostValue.ToString("N2", n)</td>
                                    <td class="text-end font-monospace fw-semibold">@r.LineMarginValue.ToString("N2", n)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="bk-reports-panel p-4">
        <div class="bk-reports-panel-title">Category mix (on-hand retail)</div>
        <div class="bk-table-wrap bk-reports-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Category</th>
                            <th class="text-end">SKUs</th>
                            <th class="text-end">Units</th>
                            <th class="text-end">Retail value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CategoryMix.Count == 0)
                        {
                            <tr>
                                <td colspan="4"><div class="bk-empty">No categories.</div></td>
                            </tr>
                        }
                        else
                        {
                            foreach (var c in Model.CategoryMix)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Category</td>
                                    <td class="text-end font-monospace">@c.SkuCount.ToString("N0", n)</td>
                                    <td class="text-end font-monospace">@c.TotalUnits.ToString("N0", n)</td>
                                    <td class="text-end font-monospace fw-semibold">@c.RetailValue.ToString("N2", n)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
