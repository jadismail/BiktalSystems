@model OperationsPurchaseOrdersViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Purchase orders";
    ViewData["Module"] = "Operations";
    var money = CultureInfo.GetCultureInfo("en-US");
    var n = CultureInfo.InvariantCulture;
}
<div class="container pb-5 pt-3 bk-reports bk-operations">
    @await Component.InvokeAsync("ModuleNav")
    <partial name="_ModuleHeader" />
    <div class="bk-reports-toolbar mb-3">
        <a asp-controller="Inventory" asp-action="PurchaseOrders" class="btn btn-primary btn-sm fw-semibold">Manage POs</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold">Operations hub</a>
    </div>
    <section class="bk-reports-kpis bk-reports-kpis--compact mb-4">
        <article class="bk-reports-kpi bk-reports-kpi--sm">
            <div class="bk-reports-kpi-label">Open orders</div>
            <div class="bk-reports-kpi-value bk-reports-kpi-value--sm">@Model.OpenCount.ToString("N0", n)</div>
            <div class="bk-reports-kpi-hint">@Model.DraftCount drafts</div>
        </article>
        <article class="bk-reports-kpi bk-reports-kpi--sm">
            <div class="bk-reports-kpi-label">Open order value</div>
            <div class="bk-reports-kpi-value bk-reports-kpi-value--sm">@Model.OpenOrderValue.ToString("C0", money)</div>
        </article>
        <article class="bk-reports-kpi bk-reports-kpi--sm">
            <div class="bk-reports-kpi-label">Received MTD</div>
            <div class="bk-reports-kpi-value bk-reports-kpi-value--sm">@Model.ReceivedMtdCount.ToString("N0", n)</div>
        </article>
    </section>
    <div class="bk-reports-panel p-4">
        <div class="bk-reports-panel-title">Recent purchase orders</div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>PO</th><th>Supplier</th><th>Status</th><th>Date</th><th class="text-end">Value</th></tr>
                </thead>
                <tbody>
                    @foreach (var po in Model.RecentOrders)
                    {
                        <tr>
                            <td><a asp-controller="Inventory" asp-action="PurchaseOrderDetail" asp-route-id="@po.Id" class="fw-semibold font-monospace">@po.OrderNumber</a></td>
                            <td>@po.SupplierName</td>
                            <td><span class="badge text-bg-light border">@po.Status</span></td>
                            <td class="small">@po.OrderDate.ToString("d", CultureInfo.CurrentCulture)</td>
                            <td class="text-end font-monospace">@po.TotalAmount.ToString("C", money)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
