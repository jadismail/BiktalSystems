@model IReadOnlyList<InsightsMovementSummaryRowViewModel>
@using System.Globalization
@{
    ViewData["Title"] = "Stock movement";
    ViewData["Module"] = "Operations";
    var money = CultureInfo.GetCultureInfo("en-US");
    var n = CultureInfo.InvariantCulture;
    var periodLabel = ViewBag.PeriodLabel as string ?? "MTD";
    var totalMovements = ViewBag.TotalMovements as int? ?? 0;
}
<div class="container pb-5 pt-3 bk-reports bk-operations">
    @await Component.InvokeAsync("ModuleNav")
    <partial name="_ModuleHeader" />
    <div class="bk-reports-toolbar mb-3">
        <span class="badge text-bg-light border fw-semibold">@periodLabel</span>
        <a asp-controller="Inventory" asp-action="Movements" class="btn btn-primary btn-sm fw-semibold ms-auto">All movements</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold">Operations hub</a>
    </div>
    <section class="bk-reports-kpis bk-reports-kpis--compact mb-4">
        <article class="bk-reports-kpi bk-reports-kpi--sm">
            <div class="bk-reports-kpi-label">Movements logged</div>
            <div class="bk-reports-kpi-value bk-reports-kpi-value--sm">@totalMovements.ToString("N0", n)</div>
        </article>
    </section>
    <div class="bk-reports-panel p-4">
        <div class="bk-reports-panel-title">By movement type</div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Type</th><th class="text-end">Count</th><th class="text-end">Net units</th><th class="text-end">Cost</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@m.TypeLabel</td>
                            <td class="text-end font-monospace">@m.Count</td>
                            <td class="text-end font-monospace">@m.NetUnits</td>
                            <td class="text-end font-monospace">@m.TotalCost.ToString("C", money)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
