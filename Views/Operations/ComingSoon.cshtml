@model OperationsComingSoonViewModel
@{
    ViewData["Title"] = Model.FeatureTitle;
    ViewData["Module"] = "Operations";
}
<div class="container pb-5 pt-3 bk-reports bk-operations">
    @await Component.InvokeAsync("ModuleNav")
    <partial name="_ModuleHeader" />
    <div class="bk-reports-toolbar mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold">Operations hub</a>
    </div>
    <div class="bk-reports-panel p-5 text-center">
        <div class="display-6 text-muted mb-3"><i class="bi bi-hourglass-split" aria-hidden="true"></i></div>
        <h2 class="h5 fw-bold">@Model.FeatureTitle</h2>
        <p class="text-muted fw-semibold small mb-0 mx-auto" style="max-width: 32rem">@Model.FeatureDescription</p>
        <p class="small text-muted mt-3 mb-0">This report is on the roadmap — operational data will wire in as those features ship.</p>
    </div>
</div>
