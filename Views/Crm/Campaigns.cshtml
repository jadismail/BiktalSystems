@model CrmCampaignsPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Campaigns";
    ViewData["Module"] = "CRM";
    ViewData["ModuleSubtitle"] = "SMS, WhatsApp, email, and push — with consent tracking.";
    string CampBadge(CrmCampaignStatus s) => s switch
    {
        CrmCampaignStatus.Draft => "text-bg-secondary",
        CrmCampaignStatus.Active => "text-bg-success",
        CrmCampaignStatus.Completed => "text-bg-primary",
        CrmCampaignStatus.Cancelled => "text-bg-dark",
        _ => "text-bg-light border"
    };
}
<div class="container pb-5 pt-3 bk-crm">
    @await Component.InvokeAsync("ModuleNav")

    <partial name="_ModuleHeader" />

    @if (TempData["CrmMessage"] is string okMsg)
    {
        <div class="alert alert-success border-0 shadow-sm d-flex align-items-start gap-2 mb-4" role="status">
            <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>@okMsg</div>
        </div>
    }

    <div class="bk-crm-panel p-4 mb-4">
        <div class="bk-crm-panel-title">New campaign</div>
        <form asp-action="CreateCampaign" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label asp-for="CreateForm.Name" class="form-label small fw-bold"></label>
                <input asp-for="CreateForm.Name" class="form-control" />
                <span asp-validation-for="CreateForm.Name" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CreateForm.Channel" class="form-label small fw-bold"></label>
                <input asp-for="CreateForm.Channel" class="form-control" placeholder="SMS, Email, …" />
                <span asp-validation-for="CreateForm.Channel" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="CreateForm.StartDate" class="form-label small fw-bold"></label>
                <input asp-for="CreateForm.StartDate" class="form-control" type="date" />
            </div>
            <div class="col-md-2">
                <label asp-for="CreateForm.EndDate" class="form-label small fw-bold"></label>
                <input asp-for="CreateForm.EndDate" class="form-control" type="date" />
                <span asp-validation-for="CreateForm.EndDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6 col-lg-2">
                <label asp-for="CreateForm.Status" class="form-label small fw-bold"></label>
                <select asp-for="CreateForm.Status" class="form-select" asp-items="Html.GetEnumSelectList<CrmCampaignStatus>()"></select>
            </div>
            <div class="col-12">
                <label asp-for="CreateForm.Description" class="form-label small fw-bold"></label>
                <textarea asp-for="CreateForm.Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary fw-semibold">Save campaign</button>
            </div>
        </form>
        <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mt-2 mb-0"></div>
    </div>

    <div class="bk-table-wrap bk-crm-table">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Campaign</th>
                        <th scope="col">Channel</th>
                        <th scope="col">Dates</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Campaigns.Count == 0)
                    {
                        <tr>
                            <td colspan="4"><div class="bk-empty">No campaigns yet — add one above.</div></td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in Model.Campaigns)
                        {
                            <tr>
                                <td class="fw-semibold">@row.Name</td>
                                <td><span class="badge text-bg-light border">@row.Channel</span></td>
                                <td class="small text-nowrap">
                                    @row.StartDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                                    @if (row.EndDate is DateOnly end)
                                    {
                                        <span class="text-muted"> → </span>
                                        @end.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                                    }
                                    else
                                    {
                                        <span class="text-muted"> — open-ended</span>
                                    }
                                </td>
                                <td><span class="badge @CampBadge(row.Status)">@CrmCampaignStatusLabels.Title(row.Status)</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
