@model Biktal.WebMVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["BodyClass"] = "bk-page-auth";
    ViewData["HideFooter"] = true;
}

<div class="bk-auth-shell">
    <div class="bk-auth-card">
        <div class="text-center mb-4">
            <img class="bk-auth-logo bk-auth-logo--light mb-3" src="~/img/khulasa-retail-light.jpg" alt="Khulasa Retail" width="1024" height="727" />
            <img class="bk-auth-logo bk-auth-logo--dark mb-3" src="~/img/khulasa-retail-dark.jpg" alt="" width="1024" height="727" />
            <h1 class="h3 fw-bold bk-hero-title">Welcome back</h1>
            <p class="text-muted small mb-0 fw-semibold">Sign in to open your Khulasa Retail workspace.</p>
        </div>

        <div class="bk-card bk-auth-panel p-4 p-lg-5">
            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3 py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-bold"></label>
                    <input asp-for="Email" class="form-control form-control-lg" autocomplete="username" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-bold"></label>
                    <div class="bk-password-field">
                        <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" data-password-input />
                        <button type="button" class="bk-password-toggle" data-password-toggle aria-label="Show password" title="Show password">
                            <i class="bi bi-eye" data-password-icon aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small fw-semibold"></label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">Continue</button>
            </form>
        </div>

        @if (ViewData["BootstrapAdminHint"] is string bootstrapHint)
        {
            <div class="alert alert-info border-0 small mt-3 mb-0 py-2 px-3" role="note">
                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>@bootstrapHint
            </div>
        }

        @if (ViewData["ShowRegisterLink"] as bool? == true)
        {
            <p class="text-center small text-muted mt-3 mb-0 fw-semibold">
                New here?
                <a asp-action="Register">Create an account</a>
                <span class="d-block mt-1 text-muted">If the database is empty, the first account becomes Administrator.</span>
            </p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            document.querySelectorAll('[data-password-toggle]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var field = btn.closest('.bk-password-field');
                    var input = field && field.querySelector('[data-password-input]');
                    var icon = btn.querySelector('[data-password-icon]');
                    if (!input) return;
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                    btn.setAttribute('title', show ? 'Hide password' : 'Show password');
                    if (icon) {
                        icon.classList.toggle('bi-eye', !show);
                        icon.classList.toggle('bi-eye-slash', show);
                    }
                });
            });
        })();
    </script>
}
