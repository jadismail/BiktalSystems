@{
    ViewData["Title"] = "Access denied";
}

<div class="bk-auth-shell">
    <div class="bk-auth-card" style="max-width: 520px;">
        <div class="bk-card p-4 p-lg-5 text-center">
            <div class="bk-brand-mark mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.1rem; background: linear-gradient(135deg, var(--bk-warning), var(--bk-danger));">!</div>
            <h1 class="h4 fw-bold bk-hero-title mb-2">Access denied</h1>
            <p class="text-muted small mb-4 fw-semibold">Ask an administrator to grant the right role, or switch to an account with permission.</p>
            <a class="btn btn-primary px-4" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
        </div>
    </div>
</div>
