@{
    ViewData["Title"] = "Access denied";
    ViewData["BodyClass"] = "bk-page-auth";
    ViewData["HideFooter"] = true;

    string backController = "Account";
    string backAction = "Index";
    string backLabel = "Back to account";

    if (User.CanAccessSales())
    {
        backController = "Pos";
        backAction = "Index";
        backLabel = "Back to POS";
    }
    else if (User.CanAccessFloor())
    {
        backController = "Repairs";
        backAction = "Index";
        backLabel = "Back to Repairs";
    }
    else if (User.CanAccessFinance())
    {
        backController = "Finance";
        backAction = "Index";
        backLabel = "Back to Finance";
    }
}

<div class="bk-auth-shell">
    <div class="bk-auth-card" style="max-width: 520px;">
        <div class="bk-card bk-auth-panel p-4 p-lg-5 text-center">
            <div class="bk-brand-mark mx-auto mb-3 bk-auth-mark" style="background: linear-gradient(135deg, var(--bk-warning), var(--bk-danger));" aria-hidden="true">!</div>
            <h1 class="h4 fw-bold bk-hero-title mb-2">Access denied</h1>
            <p class="text-muted small mb-4 fw-semibold">Ask an administrator or manager to grant the right role, or switch to an account with permission.</p>
            <a class="btn btn-primary px-4" asp-controller="@backController" asp-action="@backAction">@backLabel</a>
        </div>
    </div>
</div>
